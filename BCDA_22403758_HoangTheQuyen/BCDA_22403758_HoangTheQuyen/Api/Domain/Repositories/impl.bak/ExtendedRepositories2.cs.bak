using Dapper;
using K8sManager.Api.Infrastructure;
using K8sManager.Api.Domain.Entities;

namespace K8sManager.Api.Domain.Repositories.impl;

// ============================================================
// Task History Repository
// ============================================================

internal class TaskHistoryRepository : ITaskHistoryRepository
{
    private readonly DapperConnectionFactory _connectionFactory;

    public TaskHistoryRepository(DapperConnectionFactory connectionFactory)
    {
        _connectionFactory = connectionFactory;
    }

    public async Task<IEnumerable<TaskHistory>> GetByUserIdAsync(int userId, int limit = 100)
    {
        using var conn = _connectionFactory.Create();
        var sql = @"
            SELECT TOP (@Limit) * FROM TaskHistory 
            WHERE UserId = @UserId 
            ORDER BY StartedAt DESC";
        return await conn.QueryAsync<TaskHistory>(sql, new { UserId = userId, Limit = limit }).ConfigureAwait(false);
    }

    public async Task<IEnumerable<TaskHistory>> GetByClusterIdAsync(int clusterId, int limit = 100)
    {
        using var conn = _connectionFactory.Create();
        var sql = @"
            SELECT TOP (@Limit) * FROM TaskHistory 
            WHERE ClusterId = @ClusterId 
            ORDER BY StartedAt DESC";
        return await conn.QueryAsync<TaskHistory>(sql, new { ClusterId = clusterId, Limit = limit }).ConfigureAwait(false);
    }

    public async Task<IEnumerable<TaskHistory>> GetRecentAsync(int days = 7, int limit = 100)
    {
        using var conn = _connectionFactory.Create();
        var sql = @"
            SELECT TOP (@Limit) * FROM TaskHistory 
            WHERE StartedAt >= DATEADD(DAY, -@Days, SYSUTCDATETIME())
            ORDER BY StartedAt DESC";
        return await conn.QueryAsync<TaskHistory>(sql, new { Days = days, Limit = limit }).ConfigureAwait(false);
    }

    public async Task<TaskHistory?> GetByIdAsync(long id)
    {
        using var conn = _connectionFactory.Create();
        var sql = "SELECT * FROM TaskHistory WHERE Id = @Id";
        return await conn.QueryFirstOrDefaultAsync<TaskHistory>(sql, new { Id = id }).ConfigureAwait(false);
    }

    public async Task<long> CreateAsync(TaskHistory task)
    {
        using var conn = _connectionFactory.Create();
        var sql = @"
            INSERT INTO TaskHistory 
            (UserId, ClusterId, TaskType, Namespace, ResourceKind, ResourceName, Parameters, Status)
            VALUES 
            (@UserId, @ClusterId, @TaskType, @Namespace, @ResourceKind, @ResourceName, @Parameters, @Status);
            SELECT CAST(SCOPE_IDENTITY() as bigint)";
        return await conn.ExecuteScalarAsync<long>(sql, task).ConfigureAwait(false);
    }

    public async Task<int> UpdateStatusAsync(long id, string status, DateTime? completedAt = null, string? result = null, string? errorMessage = null, int? duration = null)
    {
        using var conn = _connectionFactory.Create();
        var sql = @"
            UPDATE TaskHistory 
            SET Status = @Status, CompletedAt = @CompletedAt, Result = @Result, 
                ErrorMessage = @ErrorMessage, Duration = @Duration
            WHERE Id = @Id";
        return await conn.ExecuteAsync(sql, new
        {
            Id = id,
            Status = status,
            CompletedAt = completedAt,
            Result = result,
            ErrorMessage = errorMessage,
            Duration = duration
        }).ConfigureAwait(false);
    }
}

// ============================================================
// Resource Cache Repository
// ============================================================

internal class ResourceCacheRepository : IResourceCacheRepository
{
    private readonly DapperConnectionFactory _connectionFactory;

    public ResourceCacheRepository(DapperConnectionFactory connectionFactory)
    {
        _connectionFactory = connectionFactory;
    }

    public async Task<ResourceCache?> GetAsync(int clusterId, string? @namespace, string resourceKind)
    {
        using var conn = _connectionFactory.Create();
        var sql = @"
            SELECT * FROM ResourceCache 
            WHERE ClusterId = @ClusterId 
              AND (@Namespace IS NULL OR Namespace = @Namespace)
              AND ResourceKind = @ResourceKind
              AND ExpiresAt > SYSUTCDATETIME()";
        return await conn.QueryFirstOrDefaultAsync<ResourceCache>(sql, new
        {
            ClusterId = clusterId,
            Namespace = @namespace,
            ResourceKind = resourceKind
        }).ConfigureAwait(false);
    }

    public async Task<int> UpsertAsync(ResourceCache cache)
    {
        using var conn = _connectionFactory.Create();
        var sql = @"
            MERGE ResourceCache AS target
            USING (SELECT @ClusterId AS ClusterId, @Namespace AS Namespace, @ResourceKind AS ResourceKind) AS source
            ON target.ClusterId = source.ClusterId 
               AND (target.Namespace = source.Namespace OR (target.Namespace IS NULL AND source.Namespace IS NULL))
               AND target.ResourceKind = source.ResourceKind
            WHEN MATCHED THEN
                UPDATE SET CacheData = @CacheData, ExpiresAt = @ExpiresAt, CreatedAt = SYSUTCDATETIME()
            WHEN NOT MATCHED THEN
                INSERT (ClusterId, Namespace, ResourceKind, CacheData, ExpiresAt)
                VALUES (@ClusterId, @Namespace, @ResourceKind, @CacheData, @ExpiresAt);";
        return await conn.ExecuteAsync(sql, cache).ConfigureAwait(false);
    }

    public async Task<int> DeleteExpiredAsync()
    {
        using var conn = _connectionFactory.Create();
        var sql = "DELETE FROM ResourceCache WHERE ExpiresAt <= SYSUTCDATETIME()";
        return await conn.ExecuteAsync(sql).ConfigureAwait(false);
    }

    public async Task<int> InvalidateAsync(int clusterId, string? @namespace, string? resourceKind = null)
    {
        using var conn = _connectionFactory.Create();

        if (resourceKind != null)
        {
            var sql = @"
                DELETE FROM ResourceCache 
                WHERE ClusterId = @ClusterId 
                  AND (@Namespace IS NULL OR Namespace = @Namespace)
                  AND ResourceKind = @ResourceKind";
            return await conn.ExecuteAsync(sql, new
            {
                ClusterId = clusterId,
                Namespace = @namespace,
                ResourceKind = resourceKind
            }).ConfigureAwait(false);
        }
        else
        {
            var sql = @"
                DELETE FROM ResourceCache 
                WHERE ClusterId = @ClusterId 
                  AND (@Namespace IS NULL OR Namespace = @Namespace)";
            return await conn.ExecuteAsync(sql, new { ClusterId = clusterId, Namespace = @namespace }).ConfigureAwait(false);
        }
    }
}

// ============================================================
// Notification Repository
// ============================================================

internal class NotificationRepository : INotificationRepository
{
    private readonly DapperConnectionFactory _connectionFactory;

    public NotificationRepository(DapperConnectionFactory connectionFactory)
    {
        _connectionFactory = connectionFactory;
    }

    public async Task<IEnumerable<Notification>> GetByUserIdAsync(int userId, bool unreadOnly = false, int limit = 50)
    {
        using var conn = _connectionFactory.Create();
        var sql = @"
            SELECT TOP (@Limit) * FROM Notification 
            WHERE UserId = @UserId" +
            (unreadOnly ? " AND IsRead = 0" : "") + @"
            ORDER BY CreatedAt DESC";
        return await conn.QueryAsync<Notification>(sql, new { UserId = userId, Limit = limit }).ConfigureAwait(false);
    }

    public async Task<int> GetUnreadCountAsync(int userId)
    {
        using var conn = _connectionFactory.Create();
        var sql = "SELECT COUNT(*) FROM Notification WHERE UserId = @UserId AND IsRead = 0";
        return await conn.ExecuteScalarAsync<int>(sql, new { UserId = userId }).ConfigureAwait(false);
    }

    public async Task<long> CreateAsync(Notification notification)
    {
        using var conn = _connectionFactory.Create();
        var sql = @"
            INSERT INTO Notification 
            (UserId, Title, Message, Type, ActionUrl)
            VALUES 
            (@UserId, @Title, @Message, @Type, @ActionUrl);
            SELECT CAST(SCOPE_IDENTITY() as bigint)";
        return await conn.ExecuteScalarAsync<long>(sql, notification).ConfigureAwait(false);
    }

    public async Task<int> MarkAsReadAsync(long id)
    {
        using var conn = _connectionFactory.Create();
        var sql = @"
            UPDATE Notification 
            SET IsRead = 1, ReadAt = SYSUTCDATETIME()
            WHERE Id = @Id";
        return await conn.ExecuteAsync(sql, new { Id = id }).ConfigureAwait(false);
    }

    public async Task<int> MarkAllAsReadAsync(int userId)
    {
        using var conn = _connectionFactory.Create();
        var sql = @"
            UPDATE Notification 
            SET IsRead = 1, ReadAt = SYSUTCDATETIME()
            WHERE UserId = @UserId AND IsRead = 0";
        return await conn.ExecuteAsync(sql, new { UserId = userId }).ConfigureAwait(false);
    }

    public async Task<int> DeleteOldAsync(int days = 30)
    {
        using var conn = _connectionFactory.Create();
        var sql = @"
            DELETE FROM Notification 
            WHERE CreatedAt < DATEADD(DAY, -@Days, SYSUTCDATETIME())";
        return await conn.ExecuteAsync(sql, new { Days = days }).ConfigureAwait(false);
    }
}

// ============================================================
// App Setting Repository
// ============================================================

internal class AppSettingRepository : IAppSettingRepository
{
    private readonly DapperConnectionFactory _connectionFactory;

    public AppSettingRepository(DapperConnectionFactory connectionFactory)
    {
        _connectionFactory = connectionFactory;
    }

    public async Task<AppSetting?> GetByKeyAsync(string key)
    {
        using var conn = _connectionFactory.Create();
        var sql = "SELECT * FROM AppSetting WHERE [Key] = @Key";
        return await conn.QueryFirstOrDefaultAsync<AppSetting>(sql, new { Key = key }).ConfigureAwait(false);
    }

    public async Task<IEnumerable<AppSetting>> GetByCategoryAsync(string category)
    {
        using var conn = _connectionFactory.Create();
        var sql = "SELECT * FROM AppSetting WHERE Category = @Category ORDER BY [Key]";
        return await conn.QueryAsync<AppSetting>(sql, new { Category = category }).ConfigureAwait(false);
    }

    public async Task<IEnumerable<AppSetting>> GetAllAsync()
    {
        using var conn = _connectionFactory.Create();
        var sql = "SELECT * FROM AppSetting ORDER BY Category, [Key]";
        return await conn.QueryAsync<AppSetting>(sql).ConfigureAwait(false);
    }

    public async Task<int> UpsertAsync(AppSetting setting)
    {
        using var conn = _connectionFactory.Create();
        var sql = @"
            MERGE AppSetting AS target
            USING (SELECT @Key AS [Key]) AS source
            ON target.[Key] = source.[Key]
            WHEN MATCHED THEN
                UPDATE SET [Value] = @Value, Category = @Category, Description = @Description, 
                           IsEncrypted = @IsEncrypted, UpdatedBy = @UpdatedBy, UpdatedAt = SYSUTCDATETIME()
            WHEN NOT MATCHED THEN
                INSERT ([Key], [Value], Category, Description, IsEncrypted, UpdatedBy)
                VALUES (@Key, @Value, @Category, @Description, @IsEncrypted, @UpdatedBy);";
        return await conn.ExecuteAsync(sql, setting).ConfigureAwait(false);
    }

    public async Task<int> DeleteAsync(string key)
    {
        using var conn = _connectionFactory.Create();
        var sql = "DELETE FROM AppSetting WHERE [Key] = @Key";
        return await conn.ExecuteAsync(sql, new { Key = key }).ConfigureAwait(false);
    }
}

