@page "/templates"
@layout MainLayout
@inject ApiClient ApiClient
@inject ToastService ToastService

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="bi bi-file-earmark-code"></i> YAML Templates</h3>
        <Button Color="ButtonColor.Primary" @onclick="ShowCreateDialog">
            <i class="bi bi-plus-lg"></i> New Template
        </Button>
    </div>

    <div class="mb-3 d-flex gap-3">
        <input type="text" class="form-control" placeholder="Search templates by name..." @bind="searchTerm" @bind:event="oninput" style="max-width: 400px;" />
        <select class="form-select" @bind="selectedCategory" style="max-width: 250px;">
            <option value="">All Categories</option>
            @foreach (var category in categories)
            {
                <option value="@category">@category</option>
            }
        </select>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <Spinner />
            <p class="text-muted mt-2">Loading templates...</p>
        </div>
    }
    else if (templates.Any())
    {
        var filteredTemplates = templates
            .Where(t => string.IsNullOrWhiteSpace(searchTerm) || t.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .Where(t => string.IsNullOrWhiteSpace(selectedCategory) || t.Category == selectedCategory)
            .ToList();

        @if (filteredTemplates.Any())
        {
            <div class="row">
                @foreach (var template in filteredTemplates)
                {
                <div class="col-md-6 col-lg-4 mb-3">
                    <Card>
                        <CardHeader>
                            <div class="d-flex justify-content-between align-items-center">
                                <strong>@template.Name</strong>
                                @if (template.IsPublic)
                                {
                                    <Badge Color="BadgeColor.Success">Public</Badge>
                                }
                                else
                                {
                                    <Badge Color="BadgeColor.Secondary">Private</Badge>
                                }
                            </div>
                        </CardHeader>
                        <CardBody>
                            <p class="text-muted small">@template.Description</p>
                            @if (!string.IsNullOrEmpty(template.Category))
                            {
                                <Badge Color="BadgeColor.Info">@template.Category</Badge>
                            }
                            <p class="small text-muted mt-2">
                                Created: @template.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </p>
                        </CardBody>
                        <CardFooter>
                            <Button Size="ButtonSize.Small" Color="ButtonColor.Success" @onclick="() => ShowApplyDialog(template)">
                                <i class="bi bi-play-circle"></i> Apply
                            </Button>
                            <Button Size="ButtonSize.Small" Color="ButtonColor.Info" @onclick="() => ViewTemplate(template)">
                                <i class="bi bi-eye"></i> View
                            </Button>
                            <Button Size="ButtonSize.Small" Color="ButtonColor.Warning" @onclick="() => ShowEditDialog(template)">
                                <i class="bi bi-pencil"></i> Edit
                            </Button>
                            <Button Size="ButtonSize.Small" Color="ButtonColor.Danger" @onclick="() => DeleteTemplate(template)">
                                <i class="bi bi-trash"></i> Delete
                            </Button>
                        </CardFooter>
                    </Card>
                </div>
            }
            </div>
        }
        else
        {
            <Alert Color="AlertColor.Warning">
                <i class="bi bi-search"></i> No templates found
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <text> matching "@searchTerm"</text>
                }
                @if (!string.IsNullOrWhiteSpace(selectedCategory))
                {
                    <text> in category "@selectedCategory"</text>
                }
            </Alert>
        }
    }
    else
    {
        <Alert Color="AlertColor.Info">
            <i class="bi bi-info-circle"></i> No templates found. Create your first template!
        </Alert>
    }
</div>

<Modal @ref="createModal" Title="Create Template">
    <BodyTemplate>
        <div class="mb-3">
            <label class="form-label">Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" @bind="newTemplateName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" rows="2" @bind="newTemplateDescription"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Category</label>
            <input type="text" class="form-control" @bind="newTemplateCategory" placeholder="e.g. Deployment, Service" />
        </div>
        <div class="mb-3">
            <label class="form-label">YAML Content <span class="text-danger">*</span></label>
            <textarea class="form-control" rows="10" @bind="newTemplateYaml" style="font-family: monospace;"></textarea>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" @bind="newTemplateIsPublic" id="isPublicCheck">
            <label class="form-check-label" for="isPublicCheck">
                Make this template public (visible to all users)
            </label>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideCreateDialog">Cancel</Button>
        <Button Color="ButtonColor.Primary" @onclick="CreateTemplate" Disabled="isCreating">
            @if (isCreating)
            {
                <Spinner Size="SpinnerSize.Small" />
            }
            Create
        </Button>
    </FooterTemplate>
</Modal>

<Modal @ref="viewModal" Title="@selectedTemplate?.Name" Size="ModalSize.Large">
    <BodyTemplate>
        @if (selectedTemplate != null)
        {
            <div class="mb-2">
                <strong>Description:</strong> @selectedTemplate.Description
            </div>
            <div class="mb-2">
                <strong>Category:</strong> @selectedTemplate.Category
            </div>
            <div class="mb-3">
                <strong>YAML Content:</strong>
                <pre class="bg-light p-3 border rounded" style="max-height: 400px; overflow-y: auto;"><code>@selectedTemplate.YamlContent</code></pre>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideViewDialog">Close</Button>
    </FooterTemplate>
</Modal>

<Modal @ref="editModal" Title="Edit Template" Size="ModalSize.Large">
    <BodyTemplate>
        <div class="mb-3">
            <label class="form-label">Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" @bind="editTemplateName" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" rows="2" @bind="editTemplateDescription"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Category</label>
            <input type="text" class="form-control" @bind="editTemplateCategory" />
        </div>
        <div class="mb-3">
            <label class="form-label">YAML Content <span class="text-danger">*</span></label>
            <textarea class="form-control" rows="15" @bind="editTemplateYaml" style="font-family: monospace;"></textarea>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideEditDialog">Cancel</Button>
        <Button Color="ButtonColor.Primary" @onclick="UpdateTemplate" Disabled="isUpdating">
            @if (isUpdating)
            {
                <Spinner Size="SpinnerSize.Small" />
            }
            Update
        </Button>
    </FooterTemplate>
</Modal>

<!-- Delete Confirmation Modal -->
<Modal @ref="deleteConfirmModal" Title="Confirm Delete">
    <BodyTemplate>
        <p>Are you sure you want to delete template <strong>@templateToDelete?.Name</strong>?</p>
        <p class="text-danger"><i class="bi bi-exclamation-triangle"></i> This action cannot be undone.</p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideDeleteConfirm">Cancel</Button>
        <Button Color="ButtonColor.Danger" @onclick="ConfirmDeleteAction">
            <i class="bi bi-trash"></i> Delete
        </Button>
    </FooterTemplate>
</Modal>

<!-- Update Confirmation Modal -->
<Modal @ref="updateConfirmModal" Title="Confirm Update">
    <BodyTemplate>
        <p>Are you sure you want to update template <strong>@editTemplateName</strong>?</p>
        <p class="text-warning"><i class="bi bi-info-circle"></i> This will modify the template configuration.</p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideUpdateConfirm">Cancel</Button>
        <Button Color="ButtonColor.Primary" @onclick="ConfirmUpdateAction">
            <i class="bi bi-check-lg"></i> Confirm Update
        </Button>
    </FooterTemplate>
</Modal>

<!-- Apply Template Modal -->
<Modal @ref="applyModal" Title="Apply Template to Cluster" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        @if (templateToApply != null)
        {
            <div class="mb-3">
                <strong>Template:</strong> @templateToApply.Name
            </div>
            <div class="mb-3">
                <label class="form-label">Namespace (optional)</label>
                <input type="text" class="form-control" @bind="applyNamespace" placeholder="default" />
                <small class="text-muted">Leave empty to use namespace from template</small>
            </div>
            <div class="mb-3">
                <label class="form-label">
                    <strong>YAML Content</strong>
                    <small class="text-muted ms-2">(You can edit before applying)</small>
                </label>
                <textarea class="form-control" rows="20" @bind="applyYamlContent" style="font-family: 'Courier New', monospace; font-size: 13px;"></textarea>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideApplyDialog">Cancel</Button>
        <Button Color="ButtonColor.Success" @onclick="ApplyTemplate" Disabled="isApplying">
            @if (isApplying)
            {
                <Spinner Size="SpinnerSize.Small" />
            }
            <i class="bi bi-play-circle"></i> Apply to Cluster
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private List<TemplateDto> templates = new();
    private bool isLoading = false;
    private bool isCreating = false;
    private bool isUpdating = false;
    private bool isApplying = false;
    private string searchTerm = "";
    private string selectedCategory = "";
    private List<string> categories = new();

    private Modal createModal = default!;
    private Modal viewModal = default!;
    private Modal editModal = default!;
    private Modal deleteConfirmModal = default!;
    private Modal updateConfirmModal = default!;
    private Modal applyModal = default!;

    private string newTemplateName = "";
    private string newTemplateDescription = "";
    private string newTemplateCategory = "";
    private string newTemplateYaml = "";
    private bool newTemplateIsPublic = false;

    private int editTemplateId;
    private string editTemplateName = "";
    private string editTemplateDescription = "";
    private string editTemplateCategory = "";
    private string editTemplateYaml = "";

    private TemplateDto? selectedTemplate;
    private TemplateDto? templateToDelete;
    private TemplateDto? templateToApply;
    private string applyNamespace = "";
    private string applyYamlContent = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplates();
    }

    private async Task LoadTemplates()
    {
        isLoading = true;
        try
        {
            templates = await ApiClient.GetTemplatesAsync();
            
            // Extract unique categories
            categories = templates
                .Where(t => !string.IsNullOrWhiteSpace(t.Category))
                .Select(t => t.Category!)
                .Distinct()
                .OrderBy(c => c)
                .ToList();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Error loading templates: {ex.Message}"));
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowCreateDialog()
    {
        newTemplateName = "";
        newTemplateDescription = "";
        newTemplateCategory = "";
        newTemplateYaml = "";
        newTemplateIsPublic = false;
        await createModal.ShowAsync();
    }

    private async Task HideCreateDialog()
    {
        await createModal.HideAsync();
    }

    private async Task CreateTemplate()
    {
        if (string.IsNullOrWhiteSpace(newTemplateName) || string.IsNullOrWhiteSpace(newTemplateYaml))
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Name and YAML content are required"));
            return;
        }

        isCreating = true;
        try
        {
            var request = new CreateTemplateRequest(
                newTemplateName,
                newTemplateYaml,
                newTemplateDescription,
                newTemplateCategory,
                null,
                newTemplateIsPublic
            );

            await ApiClient.CreateTemplateAsync(request);
            ToastService.Notify(new ToastMessage(ToastType.Success, "Template created successfully"));
            await HideCreateDialog();
            await LoadTemplates();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Error creating template: {ex.Message}"));
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task ViewTemplate(TemplateDto template)
    {
        selectedTemplate = template;
        await viewModal.ShowAsync();
    }

    private async Task HideViewDialog()
    {
        await viewModal.HideAsync();
        selectedTemplate = null;
    }

    private async Task ShowEditDialog(TemplateDto template)
    {
        editTemplateId = template.Id;
        editTemplateName = template.Name;
        editTemplateDescription = template.Description ?? "";
        editTemplateCategory = template.Category ?? "";
        editTemplateYaml = template.YamlContent ?? "";
        await editModal.ShowAsync();
    }

    private async Task HideEditDialog()
    {
        await editModal.HideAsync();
    }

    private async Task UpdateTemplate()
    {
        if (string.IsNullOrWhiteSpace(editTemplateName) || string.IsNullOrWhiteSpace(editTemplateYaml))
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Name and YAML content are required"));
            return;
        }

        await updateConfirmModal.ShowAsync();
    }

    private async Task HideUpdateConfirm()
    {
        await updateConfirmModal.HideAsync();
    }

    private async Task ConfirmUpdateAction()
    {
        await updateConfirmModal.HideAsync();
        
        isUpdating = true;
        try
        {
            var request = new UpdateTemplateRequest(
                editTemplateName,
                editTemplateYaml,
                editTemplateDescription,
                editTemplateCategory
            );

            await ApiClient.UpdateTemplateAsync(editTemplateId, request);
            ToastService.Notify(new ToastMessage(ToastType.Success, "Template updated successfully"));
            await HideEditDialog();
            await LoadTemplates();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Error updating template: {ex.Message}"));
        }
        finally
        {
            isUpdating = false;
        }
    }

    private async Task DeleteTemplate(TemplateDto template)
    {
        templateToDelete = template;
        await deleteConfirmModal.ShowAsync();
    }

    private async Task HideDeleteConfirm()
    {
        await deleteConfirmModal.HideAsync();
        templateToDelete = null;
    }

    private async Task ConfirmDeleteAction()
    {
        if (templateToDelete == null) return;

        await deleteConfirmModal.HideAsync();

        try
        {
            await ApiClient.DeleteTemplateAsync(templateToDelete.Id);
            ToastService.Notify(new ToastMessage(ToastType.Success, $"Template '{templateToDelete.Name}' deleted"));
            await LoadTemplates();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Error deleting template: {ex.Message}"));
        }
        finally
        {
            templateToDelete = null;
        }
    }

    private async Task ShowApplyDialog(TemplateDto template)
    {
        templateToApply = template;
        applyNamespace = "";
        applyYamlContent = template.YamlContent ?? "";
        await applyModal.ShowAsync();
    }

    private async Task HideApplyDialog()
    {
        await applyModal.HideAsync();
        templateToApply = null;
    }

    private async Task ApplyTemplate()
    {
        if (templateToApply == null) return;

        if (string.IsNullOrWhiteSpace(applyYamlContent))
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "YAML content cannot be empty"));
            return;
        }

        isApplying = true;
        try
        {
            // Use the edited YAML content
            var result = await ApiClient.ApplyYamlAsync(applyYamlContent);
            
            if (result.Success)
            {
                ToastService.Notify(new ToastMessage(ToastType.Success, $"Template '{templateToApply.Name}' applied successfully!\n{result.Message}"));
                await HideApplyDialog();
            }
            else
            {
                ToastService.Notify(new ToastMessage(ToastType.Danger, $"Failed to apply template: {result.Message}"));
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Error applying template: {ex.Message}"));
        }
        finally
        {
            isApplying = false;
        }
    }
}
