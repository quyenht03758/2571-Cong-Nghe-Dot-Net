@page "/k8s/pods"
@layout MainLayout
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime
@inject ILocalStorageService LocalStorage

<PageTitle>Pods - K8s Manager</PageTitle>

<div class="row mb-4">
    <div class="col">
        <h2>
            <Icon Name="IconName.Box" class="me-2" />
            Kubernetes Pods
        </h2>
    </div>
    <div class="col-auto">
        <div class="d-flex gap-2">
            <select class="form-select" @bind="selectedNamespace" @bind:after="LoadPods" style="width: 200px;">
                <option value="">Select Namespace...</option>
                @foreach (var ns in namespaces)
                {
                    <option value="@ns.Name">@ns.Name</option>
                }
            </select>
            <Button Color="ButtonColor.Secondary" @onclick="LoadPods">
                <Icon Name="IconName.ArrowClockwise" class="me-2" />
                Refresh
            </Button>
        </div>
    </div>
</div>

@if (string.IsNullOrEmpty(selectedNamespace))
{
    <Alert Color="AlertColor.Info">
        <Icon Name="IconName.InfoCircleFill" class="me-2" />
        Please select a namespace to view pods
    </Alert>
}
else if (loading)
{
    <div class="text-center p-5">
        <Spinner />
        <p class="mt-3">Loading pods from <strong>@selectedNamespace</strong>...</p>
    </div>
}
else if (error != null)
{
    <Alert Color="AlertColor.Danger" Dismissable="true">
        <Icon Name="IconName.ExclamationTriangleFill" class="me-2" />
        @error
    </Alert>
}
else if (!pods.Any())
{
    <div class="text-center p-5">
        <Icon Name="IconName.Box" Size="IconSize.x5" class="text-muted mb-3" />
        <h4>No pods found</h4>
        <p class="text-muted">No pods in namespace <strong>@selectedNamespace</strong></p>
    </div>
}
else
{
    <Card>
        <CardBody>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Restarts</th>
                            <th>Pod IP</th>
                            <th>Node</th>
                            <th>Age</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pod in pods)
                        {
                            var isFavorited = IsFavorited(pod);
                            <tr class="@(isFavorited ? "table-warning" : "")">
                                <td>
                                    @if (isFavorited)
                                    {
                                        <Icon Name="IconName.StarFill" class="text-warning me-1" Size="IconSize.x5" />
                                    }
                                    <strong>@pod.Name</strong>
                                    <br />
                                    <small class="text-muted">@pod.Namespace</small>
                                </td>
                                <td>
                                    <Badge Color="GetPodStatusColor(pod.Status)">
                                        @pod.Phase
                                    </Badge>
                                </td>
                                <td>
                                    @if (pod.RestartCount > 0)
                                    {
                                        <Badge Color="BadgeColor.Warning">@pod.RestartCount</Badge>
                                    }
                                    else
                                    {
                                        <span>0</span>
                                    }
                                </td>
                                <td><small>@pod.PodIP</small></td>
                                <td><small>@pod.NodeName</small></td>
                                <td>
                                    <small>@GetAge(pod.CreatedAt)</small>
                                </td>
                                <td>
                                    <Button Color="ButtonColor.Info" Size="ButtonSize.Small" @onclick="() => ShowPodDetails(pod)" class="me-1" title="Details">
                                        <Icon Name="IconName.InfoCircle" />
                                    </Button>
                                    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => ShowLogs(pod)" class="me-1" title="Logs">
                                        <Icon Name="IconName.FileText" />
                                    </Button>
                                    <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="() => ShowYaml(pod)" class="me-1" title="View YAML">
                                        <Icon Name="IconName.CodeSlash" />
                                    </Button>
                                    @if (!isFavorited)
                                    {
                                        <Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="() => AddToFavorite(pod)" class="me-1" title="Add to Favorites">
                                            <Icon Name="IconName.Star" />
                                        </Button>
                                    }
                                    else
                                    {
                                        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="() => RemoveFromFavorite(pod)" class="me-1" title="Remove from Favorites">
                                            <Icon Name="IconName.StarFill" />
                                        </Button>
                                    }
                                    <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => DeletePod(pod)" title="Delete">
                                        <Icon Name="IconName.Trash" />
                                    </Button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </CardBody>
    </Card>
}

<!-- Pod Details Modal -->
<Modal @ref="detailsModal" Title="@($"Pod: {selectedPod?.Name}")" Size="ModalSize.Large">
    <BodyTemplate>
        @if (selectedPod != null)
        {
            <div class="row">
                <div class="col-md-6 mb-3">
                    <strong>Namespace:</strong> @selectedPod.Namespace
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Status:</strong> <Badge Color="GetPodStatusColor(selectedPod.Status)">@selectedPod.Phase</Badge>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Pod IP:</strong> @selectedPod.PodIP
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Node:</strong> @selectedPod.NodeName
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Restart Count:</strong> @selectedPod.RestartCount
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Created:</strong> @selectedPod.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                </div>
            </div>

            @if (selectedPod.Containers != null && selectedPod.Containers.Any())
            {
                <h5 class="mt-3">Containers</h5>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Image</th>
                            <th>Ready</th>
                            <th>Restarts</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var container in selectedPod.Containers)
                        {
                            <tr>
                                <td>@container.Name</td>
                                <td><small>@container.Image</small></td>
                                <td>
                                    @if (container.Ready)
                                    {
                                        <Badge Color="BadgeColor.Success">Ready</Badge>
                                    }
                                    else
                                    {
                                        <Badge Color="BadgeColor.Danger">Not Ready</Badge>
                                    }
                                </td>
                                <td>@container.RestartCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (selectedPod.Labels != null && selectedPod.Labels.Any())
            {
                <h5 class="mt-3">Labels</h5>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var label in selectedPod.Labels)
                    {
                        <Badge Color="BadgeColor.Secondary">@label.Key=@label.Value</Badge>
                    }
                </div>
            }
        }
    </BodyTemplate>
</Modal>

<!-- Logs Modal -->
<Modal @ref="logsModal" Title="@($"Logs: {selectedPod?.Name}")" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        @if (loadingLogs)
        {
            <div class="text-center p-3">
                <Spinner />
                <p class="mt-2">Loading logs...</p>
            </div>
        }
        else if (logsError != null)
        {
            <Alert Color="AlertColor.Danger">@logsError</Alert>
        }
        else
        {
            <div style="background: #1e1e1e; color: #d4d4d4; padding: 15px; border-radius: 4px; max-height: 500px; overflow-y: auto; font-family: 'Courier New', monospace; font-size: 12px;">
                <pre style="margin: 0; white-space: pre-wrap;">@podLogs</pre>
            </div>
        }
    </BodyTemplate>
</Modal>

<!-- YAML Viewer Modal -->
<YamlViewerModal @ref="yamlViewerModal" 
                 Title="Pod YAML" 
                 ApplyYamlFunc="@(yaml => ApiClient.ApplyYamlAsync(new ApplyYamlRequest(yaml)))" />

@code {
    private List<K8sNamespaceDto> namespaces = new();
    private List<K8sPodDto> pods = new();
    private string selectedNamespace = "";
    private bool loading;
    private string? error;
    
    private Modal detailsModal = default!;
    private Modal logsModal = default!;
    private YamlViewerModal? yamlViewerModal;
    private K8sPodDto? selectedPod;
    private List<FavoriteDto> favorites = new();
    
    private bool loadingLogs;
    private string? logsError;
    private string podLogs = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadNamespaces();
    }

    private async Task LoadNamespaces()
    {
        try
        {
            favorites = await ApiClient.GetFavoritesAsync();
            namespaces = await ApiClient.GetNamespacesAsync();
            if (namespaces.Any())
            {
                // Try to restore last selected namespace
                var savedNamespace = await LocalStorage.GetItemAsStringAsync("pods_selected_namespace");
                if (!string.IsNullOrEmpty(savedNamespace) && namespaces.Any(ns => ns.Name == savedNamespace))
                {
                    selectedNamespace = savedNamespace;
                }
                else
                {
                    selectedNamespace = namespaces.First().Name;
                }
                await LoadPods();
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load namespaces: {ex.Message}";
        }
    }

    private async Task LoadPods()
    {
        if (string.IsNullOrEmpty(selectedNamespace)) return;

        loading = true;
        error = null;
        
        try
        {
            // Save selected namespace
            await LocalStorage.SetItemAsStringAsync("pods_selected_namespace", selectedNamespace);
            pods = await ApiClient.GetPodsAsync(selectedNamespace);
        }
        catch (Exception ex)
        {
            error = $"Failed to load pods: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ShowPodDetails(K8sPodDto pod)
    {
        selectedPod = pod;
        await detailsModal.ShowAsync();
    }

    private async Task ShowLogs(K8sPodDto pod)
    {
        selectedPod = pod;
        loadingLogs = true;
        logsError = null;
        podLogs = "";
        
        await logsModal.ShowAsync();
        
        try
        {
            var container = pod.Containers?.FirstOrDefault()?.Name;
            podLogs = await ApiClient.GetPodLogsAsync(pod.Namespace, pod.Name, container);
        }
        catch (Exception ex)
        {
            logsError = $"Failed to load logs: {ex.Message}";
        }
        finally
        {
            loadingLogs = false;
        }
    }

    private async Task DeletePod(K8sPodDto pod)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete pod '{pod.Name}'?"))
            return;

        try
        {
            await ApiClient.DeletePodAsync(pod.Namespace, pod.Name);
            await LoadPods();
        }
        catch (Exception ex)
        {
            error = $"Failed to delete pod: {ex.Message}";
        }
    }

    private async Task ShowYaml(K8sPodDto pod)
    {
        yamlViewerModal ??= new();
        await yamlViewerModal.ShowAsync(async () => await ApiClient.GetPodYamlAsync(pod.Namespace, pod.Name));
    }

    private async Task AddToFavorite(K8sPodDto pod)
    {
        try
        {
            // Check if already in favorites
            if (IsFavorited(pod))
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Pod '{pod.Name}' is already in favorites!");
                return;
            }

            var request = new CreateFavoriteRequest(
                ResourceType: "Pod",
                ResourceName: pod.Name,
                Namespace: pod.Namespace,
                Notes: $"Pod with {pod.Containers} container(s), status: {pod.Status}"
            );
            await ApiClient.CreateFavoriteAsync(request);
            favorites = await ApiClient.GetFavoritesAsync(); // Refresh
            await JSRuntime.InvokeVoidAsync("alert", $"Pod '{pod.Name}' added to favorites!");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Failed to add to favorites: {ex.Message}");
        }
    }

    private async Task RemoveFromFavorite(K8sPodDto pod)
    {
        try
        {
            var favorite = favorites.FirstOrDefault(f => 
                f.ResourceKind == "Pod" && 
                f.ResourceName == pod.Name && 
                f.Namespace == pod.Namespace);
            
            if (favorite != null)
            {
                await ApiClient.DeleteFavoriteAsync(favorite.Id);
                favorites = await ApiClient.GetFavoritesAsync(); // Refresh
                await JSRuntime.InvokeVoidAsync("alert", $"Pod '{pod.Name}' removed from favorites!");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Failed to remove from favorites: {ex.Message}");
        }
    }

    private bool IsFavorited(K8sPodDto pod)
    {
        return favorites.Any(f => 
            f.ResourceKind == "Pod" && 
            f.ResourceName == pod.Name && 
            f.Namespace == pod.Namespace);
    }

    private BadgeColor GetPodStatusColor(string status)
    {
        return status.ToLower() switch
        {
            "running" => BadgeColor.Success,
            "pending" => BadgeColor.Warning,
            "succeeded" => BadgeColor.Info,
            "failed" => BadgeColor.Danger,
            "unknown" => BadgeColor.Secondary,
            _ => BadgeColor.Secondary
        };
    }

    private string GetAge(DateTime createdAt)
    {
        var age = DateTime.UtcNow - createdAt;
        if (age.TotalDays >= 1)
            return $"{(int)age.TotalDays}d";
        if (age.TotalHours >= 1)
            return $"{(int)age.TotalHours}h";
        if (age.TotalMinutes >= 1)
            return $"{(int)age.TotalMinutes}m";
        return $"{(int)age.TotalSeconds}s";
    }
}
