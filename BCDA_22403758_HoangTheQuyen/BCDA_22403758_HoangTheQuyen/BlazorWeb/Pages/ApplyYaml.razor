@page "/k8s/apply"
@layout MainLayout
@inject ApiClient ApiClient

<PageTitle>Apply YAML - K8s Manager</PageTitle>

<div class="row mb-4">
    <div class="col">
        <h2>
            <Icon Name="IconName.CodeSlash" class="me-2" />
            Apply YAML
        </h2>
        <p class="text-muted">Apply Kubernetes YAML configuration</p>
    </div>
</div>

@if (applyResult != null)
{
    <Alert Color="@(applyResult.Success ? AlertColor.Success : AlertColor.Danger)" Dismissable="true" @onclick="() => applyResult = null">
        <Icon Name="@(applyResult.Success ? IconName.CheckCircleFill : IconName.ExclamationTriangleFill)" class="me-2" />
        @applyResult.Message
        @if (applyResult.CreatedResources != null && applyResult.CreatedResources.Any())
        {
            <ul class="mb-0 mt-2">
                @foreach (var resource in applyResult.CreatedResources)
                {
                    <li>@resource</li>
                }
            </ul>
        }
    </Alert>
}

<Card>
    <CardBody>
        <div class="mb-3">
            <label class="form-label">YAML Content</label>
            <textarea class="form-control font-monospace" 
                      @bind="yamlContent" 
                      rows="20" 
                      placeholder="apiVersion: v1
kind: Pod
metadata:
  name: my-pod
spec:
  containers:
  - name: nginx
    image: nginx:latest"></textarea>
            <small class="text-muted">Paste your Kubernetes YAML configuration here</small>
        </div>
        
        <div class="d-flex gap-2">
            <Button Color="ButtonColor.Primary" @onclick="ApplyConfiguration" Disabled="applying || string.IsNullOrWhiteSpace(yamlContent)">
                @if (applying)
                {
                    <Spinner Size="SpinnerSize.Small" class="me-2" />
                }
                <Icon Name="IconName.PlayFill" class="me-2" />
                Apply
            </Button>
            <Button Color="ButtonColor.Secondary" @onclick="ClearYaml">
                <Icon Name="IconName.XCircle" class="me-2" />
                Clear
            </Button>
        </div>
        
        <div class="mt-3">
            <small class="text-muted">
                <Icon Name="IconName.InfoCircle" class="me-1" />
                Note: YAML apply feature is currently in development. For full functionality, use kubectl apply.
            </small>
        </div>
    </CardBody>
</Card>

<div class="row mt-4">
    <div class="col">
        <h5>Examples</h5>
        <div class="accordion" id="examplesAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#example1">
                        Simple Pod
                    </button>
                </h2>
                <div id="example1" class="accordion-collapse collapse" data-bs-parent="#examplesAccordion">
                    <div class="accordion-body">
                        <pre class="bg-light p-3 rounded"><code>apiVersion: v1
kind: Pod
metadata:
  name: nginx-pod
  labels:
    app: nginx
spec:
  containers:
  - name: nginx
    image: nginx:latest
    ports:
    - containerPort: 80</code></pre>
                        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => UseExample(example1Yaml)">
                            Use this example
                        </Button>
                    </div>
                </div>
            </div>
            
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#example2">
                        Deployment
                    </button>
                </h2>
                <div id="example2" class="accordion-collapse collapse" data-bs-parent="#examplesAccordion">
                    <div class="accordion-body">
                        <pre class="bg-light p-3 rounded"><code>apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-deployment
spec:
  replicas: 3
  selector:
    matchLabels:
      app: nginx
  template:
    metadata:
      labels:
        app: nginx
    spec:
      containers:
      - name: nginx
        image: nginx:latest
        ports:
        - containerPort: 80</code></pre>
                        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => UseExample(example2Yaml)">
                            Use this example
                        </Button>
                    </div>
                </div>
            </div>
            
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#example3">
                        Service
                    </button>
                </h2>
                <div id="example3" class="accordion-collapse collapse" data-bs-parent="#examplesAccordion">
                    <div class="accordion-body">
                        <pre class="bg-light p-3 rounded"><code>apiVersion: v1
kind: Service
metadata:
  name: nginx-service
spec:
  selector:
    app: nginx
  ports:
  - protocol: TCP
    port: 80
    targetPort: 80
  type: LoadBalancer</code></pre>
                        <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => UseExample(example3Yaml)">
                            Use this example
                        </Button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string yamlContent = "";
    private bool applying;
    private ApplyYamlResponse? applyResult;

    private const string example1Yaml = @"apiVersion: v1
kind: Pod
metadata:
  name: nginx-pod
  labels:
    app: nginx
spec:
  containers:
  - name: nginx
    image: nginx:latest
    ports:
    - containerPort: 80";

    private const string example2Yaml = @"apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-deployment
spec:
  replicas: 3
  selector:
    matchLabels:
      app: nginx
  template:
    metadata:
      labels:
        app: nginx
    spec:
      containers:
      - name: nginx
        image: nginx:latest
        ports:
        - containerPort: 80";

    private const string example3Yaml = @"apiVersion: v1
kind: Service
metadata:
  name: nginx-service
spec:
  selector:
    app: nginx
  ports:
  - protocol: TCP
    port: 80
    targetPort: 80
  type: LoadBalancer";

    private async Task ApplyConfiguration()
    {
        if (string.IsNullOrWhiteSpace(yamlContent))
            return;

        applying = true;
        applyResult = null;

        try
        {
            var request = new ApplyYamlRequest(yamlContent);
            applyResult = await ApiClient.ApplyYamlAsync(request);
        }
        catch (Exception ex)
        {
            applyResult = new ApplyYamlResponse(false, $"Error: {ex.Message}", null);
        }
        finally
        {
            applying = false;
        }
    }

    private void ClearYaml()
    {
        yamlContent = "";
        applyResult = null;
    }

    private void UseExample(string example)
    {
        yamlContent = example;
        applyResult = null;
    }
}
