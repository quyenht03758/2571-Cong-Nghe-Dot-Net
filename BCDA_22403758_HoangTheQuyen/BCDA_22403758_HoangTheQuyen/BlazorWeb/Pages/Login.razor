@page "/login"
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@layout Layout.EmptyLayout

<style>
    .login-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #326CE5 0%, #0E4BB7 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        padding: 3rem;
        width: 100%;
        max-width: 420px;
    }

    .k8s-logo {
        width: 80px;
        height: 80px;
        margin: 0 auto 1.5rem;
        display: block;
    }

    .login-title {
        color: #1a1a1a;
        font-size: 1.75rem;
        font-weight: 600;
        text-align: center;
        margin-bottom: 0.5rem;
    }

    .login-subtitle {
        color: #666;
        text-align: center;
        margin-bottom: 2rem;
        font-size: 0.95rem;
    }

    .login-form-control {
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        transition: all 0.3s;
    }

    .login-form-control:focus {
        border-color: #326CE5;
        box-shadow: 0 0 0 0.2rem rgba(50, 108, 229, 0.15);
    }

    .login-label {
        color: #333;
        font-weight: 500;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .login-btn {
        background: linear-gradient(135deg, #326CE5 0%, #0E4BB7 100%);
        border: none;
        border-radius: 8px;
        padding: 0.85rem;
        font-size: 1rem;
        font-weight: 600;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .login-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(50, 108, 229, 0.3);
    }

    .login-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .remember-me-container {
        display: flex;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .remember-me-checkbox {
        width: 18px;
        height: 18px;
        margin-right: 0.5rem;
        cursor: pointer;
    }

    .remember-me-label {
        color: #555;
        font-size: 0.9rem;
        cursor: pointer;
        user-select: none;
    }
</style>

<div class="login-container">
    <div class="login-card">
        <!-- K8s Logo -->
        <img src="k8s-logo.svg" alt="Kubernetes" class="k8s-logo" />

        <h1 class="login-title">Kubernetes Manager</h1>
        <p class="login-subtitle">Sign in to manage your clusters</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <Alert Color="AlertColor.Danger" Dismissable="true">@errorMessage</Alert>
        }

        <div class="mb-3">
            <label class="login-label">Username</label>
            <input type="text" class="form-control login-form-control" 
                   @bind="username" 
                   placeholder="Enter your username"
                   @onkeypress="HandleKeyPress" />
        </div>

        <div class="mb-3">
            <label class="login-label">Password</label>
            <input type="password" class="form-control login-form-control" 
                   @bind="password" 
                   placeholder="Enter your password"
                   @onkeypress="HandleKeyPress" />
        </div>

        <div class="remember-me-container">
            <input type="checkbox" class="remember-me-checkbox" 
                   id="rememberMe" 
                   @bind="rememberMe" />
            <label class="remember-me-label" for="rememberMe">Remember me</label>
        </div>

        <Button Color="ButtonColor.Primary" Class="w-100 login-btn" 
                @onclick="HandleLogin" Disabled="isLoading">
            @if (isLoading)
            {
                <Spinner Size="SpinnerSize.Small" />
                <span class="ms-2">Signing in...</span>
            }
            else
            {
                <span>Sign In</span>
            }
        </Button>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private bool isLoading = false;
    private bool rememberMe = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var savedUsername = await LocalStorage.GetItemAsync<string>("savedUsername");
            var savedRememberMe = await LocalStorage.GetItemAsync<bool>("rememberMe");
            
            if (savedRememberMe && !string.IsNullOrEmpty(savedUsername))
            {
                username = savedUsername;
                rememberMe = true;
            }
        }
        catch { }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = "";
        isLoading = true;

        try
        {
            var result = await ApiClient.LoginAsync(username, password);
            if (result != null)
            {
                // Save credentials if remember me is checked
                if (rememberMe)
                {
                    await LocalStorage.SetItemAsync("savedUsername", username);
                    await LocalStorage.SetItemAsync("rememberMe", true);
                }
                else
                {
                    await LocalStorage.RemoveItemAsync("savedUsername");
                    await LocalStorage.RemoveItemAsync("rememberMe");
                }

                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "Invalid username or password";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
