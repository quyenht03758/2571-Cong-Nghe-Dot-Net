@page "/"
@layout MainLayout
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Home - K8s Manager</PageTitle>

<div class="container-fluid mt-4">
    <h3><i class="bi bi-speedometer2"></i> Dashboard</h3>

    @if (currentUser == null)
    {
        <div class="text-center py-5">
            <Spinner />
            <p class="text-muted mt-2">Loading...</p>
        </div>
    }
    else
    {
        <div class="row mt-4">
            <div class="col-md-6 col-lg-3 mb-3">
                <Card>
                    <CardBody>
                        <h6 class="text-muted">Welcome</h6>
                        <h4>@currentUser.Username</h4>
                        <Badge Color="BadgeColor.Primary">@currentUser.Role</Badge>
                    </CardBody>
                </Card>
            </div>

            <div class="col-md-6 col-lg-3 mb-3">
                <Card>
                    <CardBody>
                        <h6 class="text-muted">Templates</h6>
                        <h4>@templateCount</h4>
                        <a href="/templates" class="btn btn-sm btn-outline-primary mt-2">View Templates</a>
                    </CardBody>
                </Card>
            </div>

            <div class="col-md-6 col-lg-3 mb-3">
                <Card>
                    <CardBody>
                        <h6 class="text-muted">Favorites</h6>
                        <h4>@favoriteCount</h4>
                        <a href="/favorites" class="btn btn-sm btn-outline-primary mt-2">View Favorites</a>
                    </CardBody>
                </Card>
            </div>

            <div class="col-md-6 col-lg-3 mb-3">
                <Card>
                    <CardBody>
                        <h6 class="text-muted">Active Sessions</h6>
                        <h4>@sessionCount</h4>
                        <a href="/sessions" class="btn btn-sm btn-outline-primary mt-2">View Sessions</a>
                    </CardBody>
                </Card>
            </div>

            @if (currentUser.Role == "Admin")
            {
                <div class="col-md-6 col-lg-3 mb-3">
                    <Card>
                        <CardBody>
                            <h6 class="text-muted">Users</h6>
                            <h4>@userCount</h4>
                            <a href="/users" class="btn btn-sm btn-outline-primary mt-2">Manage Users</a>
                        </CardBody>
                    </Card>
                </div>
            }
        </div>

        <!-- Recent Audit Logs -->
        <div class="row mt-4">
            <div class="col-12">
                <Card>
                    <CardHeader>
                        <div class="d-flex justify-content-between align-items-center">
                            <strong><i class="bi bi-journal-text"></i> Recent Activity</strong>
                            <a href="/audit" class="btn btn-sm btn-outline-secondary">View All Logs</a>
                        </div>
                    </CardHeader>
                    <CardBody>
                        @if (loadingLogs)
                        {
                            <div class="text-center py-3">
                                <Spinner Size="SpinnerSize.Small" />
                                <p class="text-muted small mt-2">Loading recent activity...</p>
                            </div>
                        }
                        else if (recentLogs.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Time</th>
                                            <th>User</th>
                                            <th>Action</th>
                                            <th>Resource</th>
                                            <th>Details</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var log in recentLogs.Take(10))
                                        {
                                            <tr>
                                                <td><small>@log.CreatedAt.ToString("HH:mm:ss")</small></td>
                                                <td><small>@log.Username</small></td>
                                                <td><Badge Color="GetActionColor(log.Action)">@log.Action</Badge></td>
                                                <td><small>@(log.ResourceKind ?? "N/A")</small></td>
                                                <td><small class="text-muted">@(log.ResourceName ?? "")</small></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center mb-0">No recent activity</p>
                        }
                    </CardBody>
                </Card>
            </div>
        </div>
    }
</div>

@code {
    private UserDto? currentUser;
    private int templateCount = 0;
    private int favoriteCount = 0;
    private int sessionCount = 0;
    private int userCount = 0;
    private List<AuditLogDto> recentLogs = new();
    private bool loadingLogs = false;

    protected override async Task OnInitializedAsync()
    {
        await ApiClient.InitializeAsync();
        
        try
        {
            currentUser = await ApiClient.GetCurrentUserAsync();
            
            if (currentUser == null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            // Load statistics
            var templates = await ApiClient.GetTemplatesAsync();
            templateCount = templates.Count;

            var favorites = await ApiClient.GetFavoritesAsync();
            favoriteCount = favorites.Count;

            var sessions = await ApiClient.GetMySessionsAsync();
            sessionCount = sessions.Count;

            // Load user count for Admin
            if (currentUser.Role == "Admin")
            {
                var users = await ApiClient.GetUsersAsync();
                userCount = users.Count;
            }

            // Load recent audit logs
            await LoadRecentLogs();
        }
        catch
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async Task LoadRecentLogs()
    {
        loadingLogs = true;
        try
        {
            var allLogs = await ApiClient.GetAuditLogsAsync();
            recentLogs = allLogs.OrderByDescending(l => l.CreatedAt).Take(10).ToList();
        }
        catch
        {
            // Ignore errors loading logs
        }
        finally
        {
            loadingLogs = false;
        }
    }

    private BadgeColor GetActionColor(string action)
    {
        return action.ToLower() switch
        {
            "login" => BadgeColor.Success,
            "logout" => BadgeColor.Secondary,
            "create" => BadgeColor.Primary,
            "update" => BadgeColor.Info,
            "delete" => BadgeColor.Danger,
            "view" => BadgeColor.Light,
            _ => BadgeColor.Secondary
        };
    }
}
