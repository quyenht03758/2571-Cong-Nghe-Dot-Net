@page "/favorites"
@layout MainLayout
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Favorites - K8s Manager</PageTitle>

<div class="row mb-4">
    <div class="col">
        <h2>
            <Icon Name="IconName.StarFill" class="me-2" />
            My Favorites
        </h2>
        <p class="text-muted">Quick access to your favorite Kubernetes resources</p>
    </div>
    <div class="col-auto">
        <Button Color="ButtonColor.Primary" @onclick="ShowCreateModal">
            <Icon Name="IconName.PlusCircleFill" class="me-2" />
            Add Favorite
        </Button>
    </div>
</div>

@if (loading)
{
    <div class="text-center p-5">
        <Spinner />
        <p class="mt-3">Loading favorites...</p>
    </div>
}
else if (error != null)
{
    <Alert Color="AlertColor.Danger" Dismissable="true">
        <Icon Name="IconName.ExclamationTriangleFill" class="me-2" />
        @error
    </Alert>
}
else if (!favorites.Any())
{
    <div class="text-center p-5">
        <Icon Name="IconName.Star" Size="IconSize.x5" class="text-muted mb-3" />
        <h4>No favorites yet</h4>
        <p class="text-muted">Add your frequently accessed resources to favorites for quick access</p>
        <Button Color="ButtonColor.Primary" @onclick="ShowCreateModal" class="mt-3">
            Add Your First Favorite
        </Button>
    </div>
}
else
{
    <div class="row">
        @foreach (var favorite in favorites)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <Card>
                    <CardBody>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title mb-0">@favorite.ResourceName</h5>
                            <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => DeleteFavorite(favorite.Id)">
                                <Icon Name="IconName.Trash" />
                            </Button>
                        </div>
                        
                        <div class="mb-2">
                            <Badge Color="BadgeColor.Primary">@favorite.ResourceKind</Badge>
                        </div>
                        
                        <div class="text-muted small">
                            <div><strong>Namespace:</strong> @favorite.Namespace</div>
                            @if (!string.IsNullOrEmpty(favorite.Notes))
                            {
                                <div class="mt-2">@favorite.Notes</div>
                            }
                        </div>
                        
                        <div class="mt-3 text-muted small">
                            <Icon Name="IconName.Clock" class="me-1" />
                            Added @favorite.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                    </CardBody>
                </Card>
            </div>
        }
    </div>
}

<!-- Create Modal -->
<Modal @ref="createModal" Title="Add Favorite">
    <BodyTemplate>
        @if (createError != null)
        {
            <Alert Color="AlertColor.Danger" Dismissable="true">
                @createError
            </Alert>
        }
        
        <div class="mb-3">
            <label class="form-label">Resource Kind *</label>
            <select class="form-select" @bind="newFavorite.ResourceKind">
                <option value="">Select kind...</option>
                <option value="Pod">Pod</option>
                <option value="Deployment">Deployment</option>
                <option value="Service">Service</option>
                <option value="ConfigMap">ConfigMap</option>
                <option value="Secret">Secret</option>
                <option value="Ingress">Ingress</option>
                <option value="PersistentVolumeClaim">PersistentVolumeClaim</option>
                <option value="StatefulSet">StatefulSet</option>
                <option value="DaemonSet">DaemonSet</option>
            </select>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Resource Name *</label>
            <input type="text" class="form-control" @bind="newFavorite.ResourceName" placeholder="nginx-deployment" />
        </div>
        
        <div class="mb-3">
            <label class="form-label">Namespace *</label>
            <input type="text" class="form-control" @bind="newFavorite.Namespace" placeholder="default" />
        </div>
        
        <div class="mb-3">
            <label class="form-label">Notes</label>
            <textarea class="form-control" @bind="newFavorite.Notes" rows="3" placeholder="Optional notes..."></textarea>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideCreateModal">Cancel</Button>
        <Button Color="ButtonColor.Primary" @onclick="CreateFavorite" Disabled="creating">
            @if (creating)
            {
                <Spinner Size="SpinnerSize.Small" class="me-2" />
            }
            Add Favorite
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private List<FavoriteDto> favorites = new();
    private bool loading = true;
    private string? error;
    private Modal createModal = default!;
    private CreateFavoriteDto newFavorite = new();
    private bool creating;
    private string? createError;

    protected override async Task OnInitializedAsync()
    {
        await LoadFavorites();
    }

    private async Task LoadFavorites()
    {
        loading = true;
        error = null;
        
        try
        {
            favorites = await ApiClient.GetFavoritesAsync();
        }
        catch (Exception ex)
        {
            error = $"Failed to load favorites: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ShowCreateModal()
    {
        newFavorite = new CreateFavoriteDto();
        createError = null;
        await createModal.ShowAsync();
    }

    private async Task HideCreateModal()
    {
        await createModal.HideAsync();
    }

    private async Task CreateFavorite()
    {
        if (string.IsNullOrWhiteSpace(newFavorite.ResourceKind) ||
            string.IsNullOrWhiteSpace(newFavorite.ResourceName) ||
            string.IsNullOrWhiteSpace(newFavorite.Namespace))
        {
            createError = "Please fill in all required fields";
            return;
        }

        creating = true;
        createError = null;

        try
        {
            var request = new CreateFavoriteRequest(
                newFavorite.ResourceKind,
                newFavorite.ResourceName,
                newFavorite.Namespace,
                newFavorite.Notes
            );
            var result = await ApiClient.CreateFavoriteAsync(request);
            await HideCreateModal();
            await LoadFavorites();
        }
        catch (Exception ex)
        {
            createError = $"Failed to create favorite: {ex.Message}";
        }
        finally
        {
            creating = false;
        }
    }

    private async Task DeleteFavorite(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to remove this favorite?"))
            return;

        try
        {
            await ApiClient.DeleteFavoriteAsync(id);
            await LoadFavorites();
        }
        catch (Exception ex)
        {
            error = $"Failed to delete favorite: {ex.Message}";
        }
    }

    private class CreateFavoriteDto
    {
        public string ResourceKind { get; set; } = "";
        public string ResourceName { get; set; } = "";
        public string Namespace { get; set; } = "default";
        public string? Notes { get; set; }
    }
}
