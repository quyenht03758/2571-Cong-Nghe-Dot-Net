@page "/audit"
@layout MainLayout
@inject ApiClient ApiClient

<PageTitle>Audit Logs - K8s Manager</PageTitle>

<div class="row mb-4">
    <div class="col">
        <h2>
            <Icon Name="IconName.ClipboardDataFill" class="me-2" />
            Audit Logs
        </h2>
        <p class="text-muted">Track all user actions and system events</p>
    </div>
    <div class="col-auto">
        <Button Color="ButtonColor.Secondary" @onclick="LoadLogs">
            <Icon Name="IconName.ArrowClockwise" class="me-2" />
            Refresh
        </Button>
    </div>
</div>

<!-- Filters -->
<Card class="mb-4">
    <CardBody>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">User</label>
                <input type="text" class="form-control" @bind="filterUser" @bind:event="oninput" placeholder="Filter by user..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Action</label>
                <select class="form-select" @bind="filterAction">
                    <option value="">All Actions</option>
                    <option value="Login">Login</option>
                    <option value="Logout">Logout</option>
                    <option value="Create">Create</option>
                    <option value="Update">Update</option>
                    <option value="Delete">Delete</option>
                    <option value="View">View</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Entity Type</label>
                <input type="text" class="form-control" @bind="filterEntity" @bind:event="oninput" placeholder="Filter by entity..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">&nbsp;</label>
                <Button Color="ButtonColor.Primary" @onclick="ApplyFilters" class="w-100">
                    <Icon Name="IconName.FunnelFill" class="me-2" />
                    Apply Filters
                </Button>
            </div>
        </div>
    </CardBody>
</Card>

@if (loading)
{
    <div class="text-center p-5">
        <Spinner />
        <p class="mt-3">Loading audit logs...</p>
    </div>
}
else if (error != null)
{
    <Alert Color="AlertColor.Danger" Dismissable="true">
        <Icon Name="IconName.ExclamationTriangleFill" class="me-2" />
        @error
    </Alert>
}
else if (!filteredLogs.Any())
{
    <div class="text-center p-5">
        <Icon Name="IconName.ClipboardData" Size="IconSize.x5" class="text-muted mb-3" />
        <h4>No audit logs found</h4>
        <p class="text-muted">No logs match your current filters</p>
    </div>
}
else
{
    <Card>
        <CardBody>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Details</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in filteredLogs.Take(100))
                        {
                            <tr>
                                <td>
                                    <small>@log.CreatedAt.ToString("MMM dd, yyyy HH:mm:ss")</small>
                                </td>
                                <td>
                                    <strong>@log.Username</strong>
                                </td>
                                <td>
                                    <Badge Color="GetActionColor(log.Action)">@log.Action</Badge>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.ResourceKind))
                                    {
                                        <code>@log.ResourceKind</code>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@(log.ResourceName ?? "N/A")</small>
                                </td>
                                <td>
                                    <small class="text-muted">@log.IpAddress</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            @if (filteredLogs.Count > 100)
            {
                <div class="text-center mt-3">
                    <small class="text-muted">Showing first 100 of @filteredLogs.Count logs</small>
                </div>
            }
        </CardBody>
    </Card>
}

@code {
    private List<AuditLogDto> logs = new();
    private List<AuditLogDto> filteredLogs = new();
    private bool loading = true;
    private string? error;
    
    private string filterUser = "";
    private string filterAction = "";
    private string filterEntity = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        loading = true;
        error = null;
        
        try
        {
            logs = await ApiClient.GetAuditLogsAsync();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            error = $"Failed to load audit logs: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyFilters()
    {
        filteredLogs = logs.Where(log =>
            (string.IsNullOrEmpty(filterUser) || (log.Username?.Contains(filterUser, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (string.IsNullOrEmpty(filterAction) || (log.Action?.Equals(filterAction, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (string.IsNullOrEmpty(filterEntity) || (log.ResourceKind?.Contains(filterEntity, StringComparison.OrdinalIgnoreCase) ?? false))
        ).OrderByDescending(l => l.CreatedAt).ToList();
        
        StateHasChanged();
    }

    private BadgeColor GetActionColor(string action)
    {
        return action.ToLower() switch
        {
            "login" => BadgeColor.Success,
            "logout" => BadgeColor.Secondary,
            "create" => BadgeColor.Primary,
            "update" => BadgeColor.Info,
            "delete" => BadgeColor.Danger,
            "view" => BadgeColor.Light,
            _ => BadgeColor.Secondary
        };
    }
}
