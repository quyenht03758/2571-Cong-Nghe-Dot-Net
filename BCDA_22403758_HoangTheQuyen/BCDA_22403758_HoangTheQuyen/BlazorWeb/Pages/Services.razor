@page "/k8s/services"
@layout MainLayout
@inject ApiClient ApiClient
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JSRuntime

<PageTitle>Services - K8s Manager</PageTitle>

<div class="row mb-4">
    <div class="col">
        <h2>
            <Icon Name="IconName.Diagram3Fill" class="me-2" />
            Kubernetes Services
        </h2>
    </div>
    <div class="col-auto">
        <div class="d-flex gap-2">
            <select class="form-select" @bind="selectedNamespace" @bind:after="LoadServices" style="width: 200px;">
                <option value="">Select Namespace...</option>
                @foreach (var ns in namespaces)
                {
                    <option value="@ns.Name">@ns.Name</option>
                }
            </select>
            <Button Color="ButtonColor.Secondary" @onclick="LoadServices">
                <Icon Name="IconName.ArrowClockwise" class="me-2" />
                Refresh
            </Button>
        </div>
    </div>
</div>

@if (string.IsNullOrEmpty(selectedNamespace))
{
    <Alert Color="AlertColor.Info">
        <Icon Name="IconName.InfoCircleFill" class="me-2" />
        Please select a namespace to view services
    </Alert>
}
else if (loading)
{
    <div class="text-center p-5">
        <Spinner />
        <p class="mt-3">Loading services...</p>
    </div>
}
else if (error != null)
{
    <Alert Color="AlertColor.Danger" Dismissable="true">
        <Icon Name="IconName.ExclamationTriangleFill" class="me-2" />
        @error
    </Alert>
}
else if (!services.Any())
{
    <div class="text-center p-5">
        <Icon Name="IconName.Diagram3" Size="IconSize.x5" class="text-muted mb-3" />
        <h4>No services found</h4>
    </div>
}
else
{
    <Card>
        <CardBody>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Cluster IP</th>
                            <th>External IP</th>
                            <th>Ports</th>
                            <th>Age</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var service in services)
                        {
                            var isFavorited = IsFavorited(service);
                            <tr class="@(isFavorited ? "table-warning" : "")">
                                <td>
                                    @if (isFavorited)
                                    {
                                        <Icon Name="IconName.StarFill" class="text-warning me-1" Size="IconSize.x5" />
                                    }
                                    <strong>@service.Name</strong>
                                    <br />
                                    <small class="text-muted">@service.Namespace</small>
                                </td>
                                <td>
                                    <Badge Color="GetServiceTypeColor(service.Type)">
                                        @service.Type
                                    </Badge>
                                </td>
                                <td><code>@service.ClusterIP</code></td>
                                <td>
                                    @if (service.ExternalIPs != null && service.ExternalIPs.Any())
                                    {
                                        <code>@string.Join(", ", service.ExternalIPs)</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (service.Ports != null && service.Ports.Any())
                                    {
                                        <small>@string.Join(", ", service.Ports)</small>
                                    }
                                </td>
                                <td>
                                    <small>@GetAge(service.CreatedAt)</small>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="() => ShowYaml(service)">
                                            <Icon Name="IconName.FileEarmarkCode" class="me-1" />
                                            YAML
                                        </Button>
                                        <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => ConfirmDeleteService(service)">
                                            <Icon Name="IconName.Trash" class="me-1" />
                                            Delete
                                        </Button>
                                        @if (!isFavorited)
                                        {
                                            <Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="() => AddToFavorite(service)" title="Add to Favorites">
                                                <Icon Name="IconName.Star" class="me-1" />
                                                Favorite
                                            </Button>
                                        }
                                        else
                                        {
                                            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="() => RemoveFromFavorite(service)" title="Remove from Favorites">
                                                <Icon Name="IconName.StarFill" class="me-1" />
                                                Favorited
                                            </Button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </CardBody>
    </Card>
}

<YamlViewerModal @ref="yamlViewerModal" 
                 Title="Service YAML" 
                 ApplyYamlFunc="@(yaml => ApiClient.ApplyYamlAsync(new ApplyYamlRequest(yaml)))" />

@code {
    private List<K8sNamespaceDto> namespaces = new();
    private List<K8sServiceDto> services = new();
    private string selectedNamespace = "";
    private bool loading;
    private string? error;
    private YamlViewerModal? yamlViewerModal;
    private List<FavoriteDto> favorites = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadNamespaces();
    }

    private async Task LoadNamespaces()
    {
        try
        {
            favorites = await ApiClient.GetFavoritesAsync();
            namespaces = await ApiClient.GetNamespacesAsync();
            if (namespaces.Any())
            {
                var savedNamespace = await LocalStorage.GetItemAsStringAsync("services_selected_namespace");
                if (!string.IsNullOrEmpty(savedNamespace) && namespaces.Any(ns => ns.Name == savedNamespace))
                {
                    selectedNamespace = savedNamespace;
                }
                else
                {
                    selectedNamespace = namespaces.First().Name;
                }
                await LoadServices();
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load namespaces: {ex.Message}";
        }
    }

    private async Task LoadServices()
    {
        if (string.IsNullOrEmpty(selectedNamespace)) return;

        await LocalStorage.SetItemAsStringAsync("services_selected_namespace", selectedNamespace);

        loading = true;
        error = null;
        
        try
        {
            services = await ApiClient.GetServicesAsync(selectedNamespace);
        }
        catch (Exception ex)
        {
            error = $"Failed to load services: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ShowYaml(K8sServiceDto service)
    {
        if (yamlViewerModal == null) return;
        await yamlViewerModal.ShowAsync(async () => await ApiClient.GetServiceYamlAsync(service.Namespace, service.Name));
    }

    private async Task AddToFavorite(K8sServiceDto service)
    {
        try
        {
            if (IsFavorited(service))
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Service '{service.Name}' is already in favorites!");
                return;
            }

            var request = new CreateFavoriteRequest(
                ResourceType: "Service",
                ResourceName: service.Name,
                Namespace: service.Namespace,
                Notes: $"{service.Type} service with ClusterIP {service.ClusterIP}"
            );
            await ApiClient.CreateFavoriteAsync(request);
            favorites = await ApiClient.GetFavoritesAsync();
            await JSRuntime.InvokeVoidAsync("alert", $"Service '{service.Name}' added to favorites!");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Failed to add to favorites: {ex.Message}");
        }
    }

    private async Task RemoveFromFavorite(K8sServiceDto service)
    {
        try
        {
            var favorite = favorites.FirstOrDefault(f => 
                f.ResourceKind == "Service" && 
                f.ResourceName == service.Name && 
                f.Namespace == service.Namespace);
            
            if (favorite != null)
            {
                await ApiClient.DeleteFavoriteAsync(favorite.Id);
                favorites = await ApiClient.GetFavoritesAsync(); // Refresh
                await JSRuntime.InvokeVoidAsync("alert", $"Service '{service.Name}' removed from favorites!");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Failed to remove from favorites: {ex.Message}");
        }
    }

    private bool IsFavorited(K8sServiceDto service)
    {
        return favorites.Any(f => 
            f.ResourceKind == "Service" && 
            f.ResourceName == service.Name && 
            f.Namespace == service.Namespace);
    }

    private async Task ConfirmDeleteService(K8sServiceDto service)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete service '{service.Name}' in namespace '{service.Namespace}'? This action cannot be undone.");
        if (confirmed)
        {
            try
            {
                await ApiClient.DeleteServiceAsync(service.Namespace, service.Name);
                await JSRuntime.InvokeVoidAsync("alert", $"Service '{service.Name}' deleted successfully!");
                await LoadServices(); // Refresh list
            }
            catch (Exception ex)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Failed to delete service: {ex.Message}");
            }
        }
    }

    private BadgeColor GetServiceTypeColor(string type)
    {
        return type switch
        {
            "ClusterIP" => BadgeColor.Primary,
            "NodePort" => BadgeColor.Info,
            "LoadBalancer" => BadgeColor.Success,
            "ExternalName" => BadgeColor.Warning,
            _ => BadgeColor.Secondary
        };
    }

    private string GetAge(DateTime createdAt)
    {
        var age = DateTime.UtcNow - createdAt;
        if (age.TotalDays >= 1)
            return $"{(int)age.TotalDays}d";
        if (age.TotalHours >= 1)
            return $"{(int)age.TotalHours}h";
        return $"{(int)age.TotalMinutes}m";
    }
}
