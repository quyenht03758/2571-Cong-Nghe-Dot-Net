@page "/k8s/secrets"
@layout MainLayout
@inject ApiClient ApiClient
@inject ILocalStorageService LocalStorage
@inject IJSRuntime JSRuntime

<PageTitle>Secrets - K8s Manager</PageTitle>

<div class="row mb-4">
    <div class="col">
        <h2>
            <Icon Name="IconName.ShieldLock" class="me-2" />
            Secrets
        </h2>
        <p class="text-muted">View Kubernetes Secrets</p>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <label class="form-label">Namespace</label>
        <select class="form-select" @bind="selectedNamespace" @bind:after="LoadSecrets">
            <option value="">Select namespace...</option>
            @foreach (var ns in namespaces)
            {
                <option value="@ns.Name">@ns.Name</option>
            }
        </select>
    </div>
</div>

@if (loading)
{
    <div class="text-center p-5">
        <Spinner />
        <p class="mt-3">Loading Secrets...</p>
    </div>
}
else if (error != null)
{
    <Alert Color="AlertColor.Danger" Dismissable="true">
        <Icon Name="IconName.ExclamationTriangleFill" class="me-2" />
        @error
    </Alert>
}
else if (string.IsNullOrEmpty(selectedNamespace))
{
    <div class="text-center p-5">
        <Icon Name="IconName.ShieldLock" Size="IconSize.x5" class="text-muted mb-3" />
        <h4>Select a namespace</h4>
        <p class="text-muted">Choose a namespace to view Secrets</p>
    </div>
}
else if (!secrets.Any())
{
    <div class="text-center p-5">
        <Icon Name="IconName.ShieldLock" Size="IconSize.x5" class="text-muted mb-3" />
        <h4>No Secrets found</h4>
        <p class="text-muted">No Secrets in namespace @selectedNamespace</p>
    </div>
}
else
{
    <Card>
        <CardBody>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Namespace</th>
                            <th>Type</th>
                            <th>Data Keys</th>
                            <th>Age</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var secret in secrets)
                        {
                            var isFavorited = IsFavorited(secret);
                            <tr class="@(isFavorited ? "table-warning" : "")">
                                <td>
                                    @if (isFavorited)
                                    {
                                        <Icon Name="IconName.StarFill" class="text-warning me-1" Size="IconSize.x5" />
                                    }
                                    <Icon Name="IconName.ShieldLock" class="me-2" />
                                    <strong>@secret.Name</strong>
                                </td>
                                <td>
                                    <Badge Color="BadgeColor.Primary">@secret.Namespace</Badge>
                                </td>
                                <td>
                                    <Badge Color="GetSecretTypeColor(secret.Type)">@secret.Type</Badge>
                                </td>
                                <td>
                                    <Badge Color="BadgeColor.Info">@secret.DataCount keys</Badge>
                                </td>
                                <td>
                                    <small>@GetAge(secret.CreatedAt)</small>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="() => ShowYaml(secret)">
                                            <Icon Name="IconName.FileEarmarkCode" class="me-1" />
                                            YAML
                                        </Button>
                                        <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => ConfirmDeleteSecret(secret)">
                                            <Icon Name="IconName.Trash" class="me-1" />
                                            Delete
                                        </Button>
                                        @if (!isFavorited)
                                        {
                                            <Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="() => AddToFavorite(secret)" title="Add to Favorites">
                                                <Icon Name="IconName.Star" class="me-1" />
                                                Favorite
                                            </Button>
                                        }
                                        else
                                        {
                                            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="() => RemoveFromFavorite(secret)" title="Remove from Favorites">
                                                <Icon Name="IconName.StarFill" class="me-1" />
                                                Favorited
                                            </Button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </CardBody>
    </Card>
}

<YamlViewerModal @ref="yamlViewerModal" 
                 Title="Secret YAML" 
                 ApplyYamlFunc="@(yaml => ApiClient.ApplyYamlAsync(new ApplyYamlRequest(yaml)))" />

@code {
    private List<K8sNamespaceDto> namespaces = new();
    private List<K8sSecretDto> secrets = new();
    private string selectedNamespace = "";
    private bool loading;
    private string? error;
    private YamlViewerModal? yamlViewerModal;
    private List<FavoriteDto> favorites = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadNamespaces();
    }

    private async Task LoadNamespaces()
    {
        try
        {
            favorites = await ApiClient.GetFavoritesAsync();
            namespaces = await ApiClient.GetNamespacesAsync();
            if (namespaces.Any())
            {
                selectedNamespace = namespaces.First().Name;
                var savedNamespace = await LocalStorage.GetItemAsStringAsync("secrets_selected_namespace");
                if (!string.IsNullOrEmpty(savedNamespace) && namespaces.Any(ns => ns.Name == savedNamespace))
                {
                    selectedNamespace = savedNamespace;
                }
                else
                {
                    selectedNamespace = namespaces.First().Name;
                }
                await LoadSecrets();
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load namespaces: {ex.Message}";
        }
    }

    private async Task LoadSecrets()
    {
        if (string.IsNullOrEmpty(selectedNamespace))
            return;

        await LocalStorage.SetItemAsStringAsync("secrets_selected_namespace", selectedNamespace);

        loading = true;
        error = null;

        try
        {
            secrets = await ApiClient.GetSecretsAsync(selectedNamespace);
        }
        catch (Exception ex)
        {
            error = $"Failed to load Secrets: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ShowYaml(K8sSecretDto secret)
    {
        if (yamlViewerModal == null) return;
        await yamlViewerModal.ShowAsync(async () => await ApiClient.GetSecretYamlAsync(secret.Namespace, secret.Name));
    }

    private async Task AddToFavorite(K8sSecretDto secret)
    {
        try
        {
            if (IsFavorited(secret))
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Secret '{secret.Name}' is already in favorites!");
                return;
            }

            var request = new CreateFavoriteRequest(
                ResourceType: "Secret",
                ResourceName: secret.Name,
                Namespace: secret.Namespace,
                Notes: $"{secret.Type} secret with {secret.DataCount} data keys"
            );
            await ApiClient.CreateFavoriteAsync(request);
            favorites = await ApiClient.GetFavoritesAsync();
            await JSRuntime.InvokeVoidAsync("alert", $"Secret '{secret.Name}' added to favorites!");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Failed to add to favorites: {ex.Message}");
        }
    }

    private async Task RemoveFromFavorite(K8sSecretDto secret)
    {
        try
        {
            var favorite = favorites.FirstOrDefault(f => 
                f.ResourceKind == "Secret" && 
                f.ResourceName == secret.Name && 
                f.Namespace == secret.Namespace);
            
            if (favorite != null)
            {
                await ApiClient.DeleteFavoriteAsync(favorite.Id);
                favorites = await ApiClient.GetFavoritesAsync(); // Refresh
                await JSRuntime.InvokeVoidAsync("alert", $"Secret '{secret.Name}' removed from favorites!");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Failed to remove from favorites: {ex.Message}");
        }
    }

    private bool IsFavorited(K8sSecretDto secret)
    {
        return favorites.Any(f => 
            f.ResourceKind == "Secret" && 
            f.ResourceName == secret.Name && 
            f.Namespace == secret.Namespace);
    }

    private async Task ConfirmDeleteSecret(K8sSecretDto secret)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", 
                $"Are you sure you want to delete Secret '{secret.Name}' from namespace '{secret.Namespace}'?");
            
            if (confirmed)
            {
                await ApiClient.DeleteSecretAsync(secret.Namespace, secret.Name);
                await JSRuntime.InvokeVoidAsync("alert", $"Secret '{secret.Name}' deleted successfully!");
                await LoadSecrets(); // Refresh the list
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Failed to delete Secret: {ex.Message}");
        }
    }

    private BadgeColor GetSecretTypeColor(string type)
    {
        return type switch
        {
            "Opaque" => BadgeColor.Secondary,
            "kubernetes.io/service-account-token" => BadgeColor.Info,
            "kubernetes.io/dockerconfigjson" => BadgeColor.Primary,
            "kubernetes.io/tls" => BadgeColor.Success,
            _ => BadgeColor.Dark
        };
    }

    private string GetAge(DateTime createdAt)
    {
        var age = DateTime.UtcNow - createdAt;
        if (age.TotalDays >= 1)
            return $"{(int)age.TotalDays}d";
        if (age.TotalHours >= 1)
            return $"{(int)age.TotalHours}h";
        return $"{(int)age.TotalMinutes}m";
    }
}
