@page "/sessions"
@layout MainLayout
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Sessions - K8s Manager</PageTitle>

<div class="row mb-4">
    <div class="col">
        <h2>
            <Icon Name="IconName.PersonCircle" class="me-2" />
            Active Sessions
        </h2>
        <p class="text-muted">Manage your active login sessions</p>
    </div>
    <div class="col-auto">
        <Button Color="ButtonColor.Secondary" @onclick="LoadSessions">
            <Icon Name="IconName.ArrowClockwise" class="me-2" />
            Refresh
        </Button>
    </div>
</div>

@if (loading)
{
    <div class="text-center p-5">
        <Spinner />
        <p class="mt-3">Loading sessions...</p>
    </div>
}
else if (error != null)
{
    <Alert Color="AlertColor.Danger" Dismissable="true">
        <Icon Name="IconName.ExclamationTriangleFill" class="me-2" />
        @error
    </Alert>
}
else if (!sessions.Any())
{
    <div class="text-center p-5">
        <Icon Name="IconName.PersonCircle" Size="IconSize.x5" class="text-muted mb-3" />
        <h4>No active sessions</h4>
        <p class="text-muted">You have no active sessions at the moment</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var session in sessions)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <Card>
                    <CardBody>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="card-title mb-1">
                                    @session.UserAgent
                                </h5>
                            </div>
                            <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => DeleteSession((int)session.Id)">
                                <Icon Name="IconName.Trash" />
                            </Button>
                        </div>
                        
                        <div class="mb-2">
                            <Icon Name="IconName.GeoAltFill" class="me-2" />
                            <span>@session.IpAddress</span>
                        </div>
                        
                        <div class="mb-2">
                            <Icon Name="IconName.Clock" class="me-2" />
                            <span class="text-muted small">
                                Created: @session.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                            </span>
                        </div>
                        
                        <div class="mb-2">
                            <Icon Name="IconName.HourglassSplit" class="me-2" />
                            <span class="text-muted small">
                                Expires: @session.ExpiresAt.ToString("MMM dd, yyyy HH:mm")
                            </span>
                        </div>
                    </CardBody>
                </Card>
            </div>
        }
    </div>
    
    <div class="mt-4">
        <Alert Color="AlertColor.Info">
            <Icon Name="IconName.InfoCircleFill" class="me-2" />
            You have <strong>@sessions.Count</strong> active session(s). Revoke sessions you don't recognize to secure your account.
        </Alert>
    </div>
}

@code {
    private List<SessionDto> sessions = new();
    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await LoadSessions();
    }

    private async Task LoadSessions()
    {
        loading = true;
        error = null;
        
        try
        {
            sessions = await ApiClient.GetMySessionsAsync();
        }
        catch (Exception ex)
        {
            error = $"Failed to load sessions: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task DeleteSession(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to revoke this session?"))
            return;

        try
        {
            await ApiClient.DeleteSessionAsync(id);
            await LoadSessions();
        }
        catch (Exception ex)
        {
            error = $"Failed to delete session: {ex.Message}";
        }
    }
}
