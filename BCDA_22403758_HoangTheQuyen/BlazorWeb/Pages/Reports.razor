@page "/reports"
@using BlazorWeb.Models
@inject ApiClient ApiClient
@inject IJSRuntime JS

<PageTitle>Reports</PageTitle>

<h3>Reports</h3>

<Card>
    <CardBody>
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Report Type</label>
                <select class="form-select" @bind="selectedReportType">
                    <option value="@ReportType.UserActivity">User Activity Report</option>
                    <option value="@ReportType.AuditLog">Audit Log Summary</option>
                    <option value="@ReportType.ClusterResources">Cluster Resources Report</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">From Date</label>
                <input type="date" class="form-control" @bind="fromDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label">To Date</label>
                <input type="date" class="form-control" @bind="toDate" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <Button Color="ButtonColor.Primary" @onclick="GenerateReport" Disabled="isGenerating">
                    @if (isGenerating)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Generate
                </Button>
            </div>
        </div>

        @if (selectedReportType == ReportType.UserActivity)
        {
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="includeActiveUsers" id="includeActive">
                        <label class="form-check-label" for="includeActive">Include Active Users</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="includeLockedUsers" id="includeLocked">
                        <label class="form-check-label" for="includeLocked">Include Locked Users</label>
                    </div>
                </div>
            </div>
        }

        @if (reportData != null)
        {
            <div class="mt-4">
                <div class="d-flex justify-content-between mb-3">
                    <h5>@GetReportTitle()</h5>
                    <div>
                        <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="() => ExportReport(ExportFormat.HTML)">
                            <Icon Name="IconName.FileEarmarkCode" /> HTML
                        </Button>
                        <Button Color="ButtonColor.Info" Size="ButtonSize.Small" @onclick="() => ExportReport(ExportFormat.Text)">
                            <Icon Name="IconName.FileEarmarkText" /> Text
                        </Button>
                        <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="() => ExportReport(ExportFormat.CSV)">
                            <Icon Name="IconName.FileEarmarkSpreadsheet" /> CSV
                        </Button>
                    </div>
                </div>

                @if (selectedReportType == ReportType.UserActivity)
                {
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="text-center p-3 border rounded">
                                <h2 class="text-primary">@userReportData.TotalUsers</h2>
                                <small class="text-muted">Total Users</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center p-3 border rounded">
                                <h2 class="text-success">@userReportData.ActiveUsers</h2>
                                <small class="text-muted">Active Users</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center p-3 border rounded">
                                <h2 class="text-danger">@userReportData.LockedUsers</h2>
                                <small class="text-muted">Locked Users</small>
                            </div>
                        </div>
                    </div>
                    
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Full Name</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Last Login</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in userReportData.Users)
                            {
                                <tr>
                                    <td><strong>@user.Username</strong></td>
                                    <td>@user.FullName</td>
                                    <td><Badge Color="BadgeColor.Info">@user.Role</Badge></td>
                                    <td>
                                        @if (user.IsLocked)
                                        {
                                            <Badge Color="BadgeColor.Danger">Locked</Badge>
                                        }
                                        else
                                        {
                                            <Badge Color="BadgeColor.Success">Active</Badge>
                                        }
                                    </td>
                                    <td><small>@(user.LastLogin?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</small></td>
                                    <td><Badge Color="BadgeColor.Secondary">@user.ActionCount</Badge></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (selectedReportType == ReportType.AuditLog)
                {
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="text-center p-3 border rounded">
                                <h2 class="text-primary">@auditReportData.TotalActions</h2>
                                <small class="text-muted">Total Actions</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center p-3 border rounded">
                                <h2 class="text-success">@auditReportData.SuccessfulActions</h2>
                                <small class="text-muted">Successful</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center p-3 border rounded">
                                <h2 class="text-danger">@auditReportData.FailedActions</h2>
                                <small class="text-muted">Failed</small>
                            </div>
                        </div>
                    </div>

                    @if (auditReportData.TotalActions == 0)
                    {
                        <div class="alert alert-info">
                            No audit log data found for the selected date range (@fromDate.ToString("MMM dd, yyyy") - @toDate.ToString("MMM dd, yyyy")).
                            Try selecting a different date range.
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <h5>Actions by Type</h5>
                                <table class="table table-sm">
                                    <thead>
                                        <tr><th>Action</th><th>Count</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in auditReportData.ActionsByType)
                                        {
                                            <tr>
                                                <td><Badge Color="BadgeColor.Primary">@item.Action</Badge></td>
                                                <td>@item.Count</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h5>Recent Actions (Last 20)</h5>
                                <table class="table table-sm">
                                    <thead>
                                        <tr><th>User</th><th>Action</th><th>Resource</th><th>Time</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var log in auditReportData.RecentLogs)
                                        {
                                            <tr>
                                                <td><small>@log.Username</small></td>
                                                <td><Badge Color="BadgeColor.Info">@log.Action</Badge></td>
                                                <td><small>@log.ResourceKind/@log.ResourceName</small></td>
                                                <td><small>@log.CreatedAt.ToString("MMM dd HH:mm")</small></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
                else if (selectedReportType == ReportType.ClusterResources)
                {
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="text-center p-3 border rounded">
                                <h3 class="text-primary">@clusterReportData.NamespaceCount</h3>
                                <small class="text-muted">Namespaces</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 border rounded">
                                <h3 class="text-info">@clusterReportData.DeploymentCount</h3>
                                <small class="text-muted">Deployments</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 border rounded">
                                <h3 class="text-warning">@clusterReportData.ServiceCount</h3>
                                <small class="text-muted">Services</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3 border rounded">
                                <h3 class="text-success">@clusterReportData.PodCount</h3>
                                <small class="text-muted">Pods</small>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="text-center p-2 border rounded">
                                <strong>Running:</strong> @clusterReportData.RunningPods
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center p-2 border rounded">
                                <strong>Pending:</strong> @clusterReportData.PendingPods
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center p-2 border rounded">
                                <strong>Failed:</strong> @clusterReportData.FailedPods
                            </div>
                        </div>
                    </div>

                    <h5>Resources by Namespace</h5>
                    <table class="table table-sm">
                        <thead>
                            <tr><th>Namespace</th><th>Deployments</th><th>Services</th><th>Pods</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in clusterReportData.ResourcesByNamespace)
                            {
                                <tr>
                                    <td><strong>@item.Namespace</strong></td>
                                    <td><Badge Color="BadgeColor.Info">@item.Deployments</Badge></td>
                                    <td><Badge Color="BadgeColor.Warning">@item.Services</Badge></td>
                                    <td><Badge Color="BadgeColor.Success">@item.Pods</Badge></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    </CardBody>
</Card>

@code {
    private enum ReportType { UserActivity, AuditLog, ClusterResources }
    private enum ExportFormat { HTML, Text, CSV }
    
    private ReportType selectedReportType = ReportType.UserActivity;
    private DateTime fromDate = DateTime.Now.AddDays(-30).Date;
    private DateTime toDate = DateTime.Now.Date;
    private bool includeActiveUsers = true;
    private bool includeLockedUsers = true;
    private bool isGenerating = false;
    private object? reportData = null;

    private UserActivityReportData userReportData = new();
    private AuditLogReportData auditReportData = new();
    private ClusterResourcesReportData clusterReportData = new();

    private class UserActivityReportData
    {
        public int TotalUsers { get; set; }
        public int ActiveUsers { get; set; }
        public int LockedUsers { get; set; }
        public List<UserActivityItem> Users { get; set; } = new();
    }

    private class UserActivityItem
    {
        public string Username { get; set; } = "";
        public string? FullName { get; set; }
        public string Role { get; set; } = "";
        public bool IsLocked { get; set; }
        public DateTime? LastLogin { get; set; }
        public int ActionCount { get; set; }
    }

    private class AuditLogReportData
    {
        public int TotalActions { get; set; }
        public int SuccessfulActions { get; set; }
        public int FailedActions { get; set; }
        public List<ActionTypeCount> ActionsByType { get; set; } = new();
        public List<AuditLogDto> RecentLogs { get; set; } = new();
    }

    private class ActionTypeCount
    {
        public string Action { get; set; } = "";
        public int Count { get; set; }
    }

    private class ClusterResourcesReportData
    {
        public int NamespaceCount { get; set; }
        public int DeploymentCount { get; set; }
        public int ServiceCount { get; set; }
        public int PodCount { get; set; }
        public int RunningPods { get; set; }
        public int PendingPods { get; set; }
        public int FailedPods { get; set; }
        public List<NamespaceResourceCount> ResourcesByNamespace { get; set; } = new();
    }

    private class NamespaceResourceCount
    {
        public string Namespace { get; set; } = "";
        public int Deployments { get; set; }
        public int Services { get; set; }
        public int Pods { get; set; }
    }

    private async Task GenerateReport()
    {
        isGenerating = true;
        reportData = null;
        StateHasChanged();
        
        try
        {
            if (selectedReportType == ReportType.UserActivity)
                await GenerateUserActivityReport();
            else if (selectedReportType == ReportType.AuditLog)
                await GenerateAuditLogReport();
            else if (selectedReportType == ReportType.ClusterResources)
                await GenerateClusterResourcesReport();
                
            reportData = new object(); // Just to mark as loaded
        }
        finally
        {
            isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task GenerateUserActivityReport()
    {
        var users = await ApiClient.GetUsersAsync();
        var auditLogs = await ApiClient.GetAuditLogsAsync(1, 1000);
        
        var filteredUsers = users.AsEnumerable();
        if (!includeActiveUsers)
            filteredUsers = filteredUsers.Where(u => u.IsLocked);
        if (!includeLockedUsers)
            filteredUsers = filteredUsers.Where(u => !u.IsLocked);
        
        userReportData = new UserActivityReportData
        {
            TotalUsers = users.Count,
            ActiveUsers = users.Count(u => !u.IsLocked),
            LockedUsers = users.Count(u => u.IsLocked),
            Users = filteredUsers.Select(u => new UserActivityItem
            {
                Username = u.Username,
                FullName = u.FullName,
                Role = u.Role,
                IsLocked = u.IsLocked,
                LastLogin = u.LastLoginAt,
                ActionCount = auditLogs.Count(log => log.UserId == u.Id && log.CreatedAt >= fromDate && log.CreatedAt <= toDate)
            }).ToList()
        };
    }

    private async Task GenerateAuditLogReport()
    {
        // Get more audit logs for comprehensive report
        var auditLogs = await ApiClient.GetAuditLogsAsync(1, 1000);
        var filteredLogs = auditLogs.Where(l => l.CreatedAt >= fromDate && l.CreatedAt <= toDate).ToList();
        
        auditReportData = new AuditLogReportData
        {
            TotalActions = filteredLogs.Count,
            SuccessfulActions = filteredLogs.Count(l => l.Success),
            FailedActions = filteredLogs.Count(l => !l.Success),
            ActionsByType = filteredLogs
                .GroupBy(l => l.Action)
                .Select(g => new ActionTypeCount { Action = g.Key, Count = g.Count() })
                .OrderByDescending(x => x.Count)
                .ToList(),
            RecentLogs = filteredLogs.OrderByDescending(l => l.CreatedAt).Take(20).ToList()
        };
    }

    private async Task GenerateClusterResourcesReport()
    {
        var namespaces = await ApiClient.GetNamespacesAsync();
        
        var allDeployments = new List<K8sDeploymentDto>();
        var allServices = new List<K8sServiceDto>();
        var allPods = new List<K8sPodDto>();
        
        foreach (var ns in namespaces)
        {
            var deployments = await ApiClient.GetDeploymentsAsync(ns.Name, null);
            var services = await ApiClient.GetServicesAsync(ns.Name, null);
            var pods = await ApiClient.GetPodsAsync(ns.Name, null);
            
            allDeployments.AddRange(deployments);
            allServices.AddRange(services);
            allPods.AddRange(pods);
        }
        
        clusterReportData = new ClusterResourcesReportData
        {
            NamespaceCount = namespaces.Count,
            DeploymentCount = allDeployments.Count,
            ServiceCount = allServices.Count,
            PodCount = allPods.Count,
            RunningPods = allPods.Count(p => p.Status == "Running"),
            PendingPods = allPods.Count(p => p.Status == "Pending"),
            FailedPods = allPods.Count(p => p.Status == "Failed"),
            ResourcesByNamespace = namespaces.Select(ns => new NamespaceResourceCount
            {
                Namespace = ns.Name,
                Deployments = allDeployments.Count(d => d.Namespace == ns.Name),
                Services = allServices.Count(s => s.Namespace == ns.Name),
                Pods = allPods.Count(p => p.Namespace == ns.Name)
            }).ToList()
        };
    }

    private string GetReportTitle()
    {
        return selectedReportType switch
        {
            ReportType.UserActivity => "User Activity Report",
            ReportType.AuditLog => "Audit Log Summary",
            ReportType.ClusterResources => "Cluster Resources Report",
            _ => "Report"
        };
    }

    private async Task ExportReport(ExportFormat format)
    {
        string content = format switch
        {
            ExportFormat.HTML => GenerateHtmlReport(),
            ExportFormat.Text => GenerateTextReport(),
            ExportFormat.CSV => GenerateCsvReport(),
            _ => ""
        };

        string fileName = $"{GetReportTitle().Replace(" ", "_")}_{DateTime.Now:yyyyMMdd_HHmmss}.{format.ToString().ToLower()}";
        string mimeType = format switch
        {
            ExportFormat.HTML => "text/html",
            ExportFormat.Text => "text/plain",
            ExportFormat.CSV => "text/csv",
            _ => "text/plain"
        };

        await JS.InvokeVoidAsync("downloadFile", fileName, content, mimeType);
    }

    private string GenerateHtmlReport()
    {
        var content = selectedReportType switch
        {
            ReportType.UserActivity => GenerateUserActivityHtml(),
            ReportType.AuditLog => GenerateAuditLogHtml(),
            ReportType.ClusterResources => GenerateClusterResourcesHtml(),
            _ => "<p>No data</p>"
        };

        return $@"<!DOCTYPE html>
<html>
<head>
    <meta charset='UTF-8'>
    <title>{GetReportTitle()}</title>
    <style>
        body {{ font-family: Arial, sans-serif; margin: 20px; }}
        table {{ border-collapse: collapse; width: 100%; margin: 20px 0; }}
        th, td {{ border: 1px solid #ddd; padding: 8px; text-align: left; }}
        th {{ background-color: #f2f2f2; }}
        .summary {{ background-color: #f9f9f9; padding: 15px; margin: 20px 0; border-radius: 5px; }}
    </style>
</head>
<body>
    <h1>{GetReportTitle()}</h1>
    <div class='summary'>
        <strong>Report Period:</strong> {fromDate:MMM dd, yyyy} - {toDate:MMM dd, yyyy}<br/>
        <strong>Generated:</strong> {DateTime.Now:MMM dd, yyyy HH:mm:ss}
    </div>
    {content}
</body>
</html>";
    }

    private string GenerateUserActivityHtml()
    {
        var html = $@"
<div class='summary'>
    <h3>Summary</h3>
    Total Users: {userReportData.TotalUsers}<br/>
    Active Users: {userReportData.ActiveUsers}<br/>
    Locked Users: {userReportData.LockedUsers}
</div>
<h3>User Details</h3>
<table>
    <tr><th>Username</th><th>Full Name</th><th>Role</th><th>Status</th><th>Last Login</th><th>Actions</th></tr>";
        
        foreach (var user in userReportData.Users)
        {
            var lastLogin = user.LastLogin.HasValue ? user.LastLogin.Value.ToString("MMM dd, yyyy HH:mm") : "Never";
            html += $"<tr><td>{user.Username}</td><td>{user.FullName}</td><td>{user.Role}</td><td>{(user.IsLocked ? "Locked" : "Active")}</td><td>{lastLogin}</td><td>{user.ActionCount}</td></tr>";
        }
        html += "</table>";
        return html;
    }

    private string GenerateAuditLogHtml()
    {
        var html = $@"
<div class='summary'>
    <h3>Summary</h3>
    Total Actions: {auditReportData.TotalActions}<br/>
    Successful: {auditReportData.SuccessfulActions}<br/>
    Failed: {auditReportData.FailedActions}
</div>
<h3>Recent Actions</h3>
<table>
    <tr><th>User</th><th>Action</th><th>Resource</th><th>Time</th></tr>";
        
        foreach (var log in auditReportData.RecentLogs)
        {
            html += $"<tr><td>{log.Username}</td><td>{log.Action}</td><td>{log.ResourceKind}/{log.ResourceName}</td><td>{log.CreatedAt:MMM dd, yyyy HH:mm}</td></tr>";
        }
        html += "</table>";
        return html;
    }

    private string GenerateClusterResourcesHtml()
    {
        var html = $@"
<div class='summary'>
    <h3>Summary</h3>
    Namespaces: {clusterReportData.NamespaceCount}<br/>
    Deployments: {clusterReportData.DeploymentCount}<br/>
    Services: {clusterReportData.ServiceCount}<br/>
    Pods: {clusterReportData.PodCount} (Running: {clusterReportData.RunningPods}, Pending: {clusterReportData.PendingPods}, Failed: {clusterReportData.FailedPods})
</div>
<h3>Resources by Namespace</h3>
<table>
    <tr><th>Namespace</th><th>Deployments</th><th>Services</th><th>Pods</th></tr>";
        
        foreach (var item in clusterReportData.ResourcesByNamespace)
        {
            html += $"<tr><td>{item.Namespace}</td><td>{item.Deployments}</td><td>{item.Services}</td><td>{item.Pods}</td></tr>";
        }
        html += "</table>";
        return html;
    }

    private string GenerateTextReport()
    {
        var content = selectedReportType switch
        {
            ReportType.UserActivity => GenerateUserActivityText(),
            ReportType.AuditLog => GenerateAuditLogText(),
            ReportType.ClusterResources => GenerateClusterResourcesText(),
            _ => "No data"
        };

        return $@"{GetReportTitle()}
{'='.ToString().PadRight(50, '=')}

Report Period: {fromDate:MMM dd, yyyy} - {toDate:MMM dd, yyyy}
Generated: {DateTime.Now:MMM dd, yyyy HH:mm:ss}

{content}";
    }

    private string GenerateUserActivityText()
    {
        var text = $@"SUMMARY
-------
Total Users: {userReportData.TotalUsers}
Active Users: {userReportData.ActiveUsers}
Locked Users: {userReportData.LockedUsers}

USER DETAILS
------------";
        
        foreach (var user in userReportData.Users)
        {
            var status = user.IsLocked ? "Locked" : "Active";
            var lastLogin = user.LastLogin.HasValue ? user.LastLogin.Value.ToString("MMM dd, yyyy HH:mm") : "Never";
            text += $@"
Username: {user.Username}
Full Name: {user.FullName}
Role: {user.Role}
Status: {status}
Last Login: {lastLogin}
Actions: {user.ActionCount}
---";
        }
        return text;
    }

    private string GenerateAuditLogText()
    {
        var text = $@"SUMMARY
-------
Total Actions: {auditReportData.TotalActions}
Successful: {auditReportData.SuccessfulActions}
Failed: {auditReportData.FailedActions}

RECENT ACTIONS
--------------";
        
        foreach (var log in auditReportData.RecentLogs)
        {
            text += $@"
User: {log.Username}
Action: {log.Action}
Resource: {log.ResourceKind}/{log.ResourceName}
Time: {log.CreatedAt:MMM dd, yyyy HH:mm}
---";
        }
        return text;
    }

    private string GenerateClusterResourcesText()
    {
        var text = $@"SUMMARY
-------
Namespaces: {clusterReportData.NamespaceCount}
Deployments: {clusterReportData.DeploymentCount}
Services: {clusterReportData.ServiceCount}
Pods: {clusterReportData.PodCount}
- Running: {clusterReportData.RunningPods}
- Pending: {clusterReportData.PendingPods}
- Failed: {clusterReportData.FailedPods}

RESOURCES BY NAMESPACE
----------------------";
        
        foreach (var item in clusterReportData.ResourcesByNamespace)
        {
            text += $@"
Namespace: {item.Namespace}
- Deployments: {item.Deployments}
- Services: {item.Services}
- Pods: {item.Pods}
---";
        }
        return text;
    }

    private string GenerateCsvReport()
    {
        if (selectedReportType == ReportType.UserActivity)
        {
            var csv = "Username,Full Name,Role,Status,Last Login,Actions\n";
            foreach (var user in userReportData.Users)
            {
                var status = user.IsLocked ? "Locked" : "Active";
                var lastLogin = user.LastLogin.HasValue ? user.LastLogin.Value.ToString("MMM dd, yyyy HH:mm") : "Never";
                csv += $"\"{user.Username}\",\"{user.FullName}\",\"{user.Role}\",\"{status}\",\"{lastLogin}\",\"{user.ActionCount}\"\n";
            }
            return csv;
        }
        else if (selectedReportType == ReportType.AuditLog)
        {
            var csv = "User,Action,Resource,Time\n";
            foreach (var log in auditReportData.RecentLogs)
            {
                csv += $"\"{log.Username}\",\"{log.Action}\",\"{log.ResourceKind}/{log.ResourceName}\",\"{log.CreatedAt:MMM dd, yyyy HH:mm}\"\n";
            }
            return csv;
        }
        else if (selectedReportType == ReportType.ClusterResources)
        {
            var csv = "Namespace,Deployments,Services,Pods\n";
            foreach (var item in clusterReportData.ResourcesByNamespace)
            {
                csv += $"\"{item.Namespace}\",\"{item.Deployments}\",\"{item.Services}\",\"{item.Pods}\"\n";
            }
            return csv;
        }
        return "No data available";
    }
}
