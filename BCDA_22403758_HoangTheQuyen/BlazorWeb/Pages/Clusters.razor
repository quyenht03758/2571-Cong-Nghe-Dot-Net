@page "/clusters"
@layout MainLayout
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime
@using YamlDotNet.Serialization
@using System.IO

<PageTitle>Clusters - K8s Manager</PageTitle>

<div class="row mb-4">
    <div class="col">
        <h2>
            <Icon Name="IconName.HddNetworkFill" class="me-2" />
            Kubernetes Clusters
        </h2>
        <p class="text-muted">Manage your Kubernetes cluster connections</p>
    </div>
    <div class="col-auto">
        <Button Color="ButtonColor.Success" @onclick="ShowImportModal" class="me-2">
            <Icon Name="IconName.FileEarmarkArrowUp" class="me-2" />
            Import from Kubeconfig
        </Button>
        <Button Color="ButtonColor.Primary" @onclick="ShowCreateModal">
            <Icon Name="IconName.PlusCircleFill" class="me-2" />
            Add Cluster
        </Button>
    </div>
</div>

@if (loading)
{
    <div class="text-center p-5">
        <Spinner />
        <p class="mt-3">Loading clusters...</p>
    </div>
}
else if (error != null)
{
    <Alert Color="AlertColor.Danger" Dismissable="true">
        <Icon Name="IconName.ExclamationTriangleFill" class="me-2" />
        @error
    </Alert>
}
else if (!clusters.Any())
{
    <div class="text-center p-5">
        <Icon Name="IconName.HddNetwork" Size="IconSize.x5" class="text-muted mb-3" />
        <h4>No clusters configured</h4>
        <p class="text-muted">Add your first Kubernetes cluster to get started</p>
        <Button Color="ButtonColor.Primary" @onclick="ShowCreateModal" class="mt-3">
            Add Your First Cluster
        </Button>
    </div>
}
else
{
    <div class="row">
        @foreach (var cluster in clusters)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <Card>
                    <CardBody>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title mb-0">
                                @cluster.Name
                                @if (cluster.IsDefault)
                                {
                                    <Badge Color="BadgeColor.Success" class="ms-2">Default</Badge>
                                }
                            </h5>
                            <div>
                                @if (!cluster.IsDefault)
                                {
                                    <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="() => SetDefault(cluster.Id)" class="me-1">
                                        <Icon Name="IconName.StarFill" />
                                    </Button>
                                }
                                <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => DeleteCluster(cluster.Id)">
                                    <Icon Name="IconName.Trash" />
                                </Button>
                            </div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(cluster.Environment))
                        {
                            <div class="mb-2">
                                <Badge Color="GetEnvironmentColor(cluster.Environment)">@cluster.Environment</Badge>
                            </div>
                        }
                        
                        <div class="text-muted small">
                            <div><strong>Context:</strong> @cluster.ContextName</div>
                            <div><strong>Kubeconfig:</strong> @cluster.KubeconfigPath</div>
                            @if (!string.IsNullOrEmpty(cluster.Description))
                            {
                                <div class="mt-2">@cluster.Description</div>
                            }
                        </div>
                        
                        <div class="mt-3 text-muted small">
                            <Icon Name="IconName.Clock" class="me-1" />
                            Added @cluster.CreatedAt.ToString("MMM dd, yyyy")
                        </div>
                    </CardBody>
                </Card>
            </div>
        }
    </div>
}

<!-- Create Modal -->
<Modal @ref="createModal" Title="Add Kubernetes Cluster" Size="ModalSize.Large">
    <BodyTemplate>
        @if (createError != null)
        {
            <Alert Color="AlertColor.Danger" Dismissable="true">
                @createError
            </Alert>
        }
        
        <div class="mb-3">
            <label class="form-label">Cluster Name *</label>
            <input type="text" class="form-control" @bind="newCluster.Name" placeholder="production-cluster" />
            <small class="text-muted">A friendly name for this cluster</small>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Kubeconfig Path *</label>
            <input type="text" class="form-control" @bind="newCluster.KubeconfigPath" placeholder="C:\Users\user\.kube\config" />
            <small class="text-muted">Path to your kubeconfig file</small>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Context Name *</label>
            <input type="text" class="form-control" @bind="newCluster.ContextName" placeholder="docker-desktop" />
            <small class="text-muted">Kubernetes context name from your kubeconfig</small>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Environment</label>
            <select class="form-select" @bind="newCluster.Environment">
                <option value="">Select environment...</option>
                <option value="Development">Development</option>
                <option value="Staging">Staging</option>
                <option value="Production">Production</option>
            </select>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" @bind="newCluster.Description" rows="3" placeholder="Optional description..."></textarea>
        </div>
        
        <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" @bind="newCluster.IsDefault" id="isDefaultCheck" />
            <label class="form-check-label" for="isDefaultCheck">
                Set as default cluster
            </label>
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideCreateModal">Cancel</Button>
        <Button Color="ButtonColor.Primary" @onclick="CreateCluster" Disabled="creating">
            @if (creating)
            {
                <Spinner Size="SpinnerSize.Small" class="me-2" />
            }
            Add Cluster
        </Button>
    </FooterTemplate>
</Modal>

<!-- Import from Kubeconfig Modal -->
<Modal @ref="importModal" Title="Import Clusters from Kubeconfig" Size="ModalSize.Large">
    <BodyTemplate>
        @if (importError != null)
        {
            <Alert Color="AlertColor.Danger" Dismissable="true">
                <Icon Name="IconName.ExclamationTriangleFill" class="me-2" />
                @importError
            </Alert>
        }
        
        <div class="mb-3">
            <label class="form-label">Kubeconfig File Path *</label>
            <input type="text" class="form-control" @bind="kubeconfigPath" placeholder="C:\Users\user\.kube\config or %USERPROFILE%\.kube\config" />
            <small class="text-muted">Default: %USERPROFILE%\.kube\config</small>
        </div>
        
        <div class="mb-3">
            <Button Color="ButtonColor.Primary" @onclick="LoadContextsFromKubeconfig" Disabled="loadingContexts">
                @if (loadingContexts)
                {
                    <Spinner Size="SpinnerSize.Small" class="me-2" />
                }
                Load Contexts
            </Button>
        </div>
        
        @if (availableContexts.Any())
        {
            <div class="alert alert-info">
                <Icon Name="IconName.InfoCircleFill" class="me-2" />
                Found @availableContexts.Count context(s). Select which ones to import:
            </div>
            
            <div class="mb-3">
                <label class="form-label">Default Environment for All</label>
                <select class="form-select" @bind="importEnvironment">
                    <option value="">None</option>
                    <option value="Development">Development</option>
                    <option value="Staging">Staging</option>
                    <option value="Production">Production</option>
                </select>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th width="50">
                                <input type="checkbox" class="form-check-input" 
                                       @onchange="e => ToggleAllContexts((bool)e.Value!)" 
                                       checked="@(selectedContexts.Count == availableContexts.Count)" />
                            </th>
                            <th>Context Name</th>
                            <th>Cluster</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ctx in availableContexts)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input" 
                                           @onchange="e => ToggleContext(ctx.Name, (bool)e.Value!)"
                                           checked="@selectedContexts.Contains(ctx.Name)" />
                                </td>
                                <td><strong>@ctx.Name</strong></td>
                                <td><code>@ctx.Cluster</code></td>
                                <td><small class="text-muted">@ctx.User</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideImportModal">Cancel</Button>
        <Button Color="ButtonColor.Success" @onclick="ImportSelectedClusters" 
                Disabled="importing || !selectedContexts.Any()">
            @if (importing)
            {
                <Spinner Size="SpinnerSize.Small" class="me-2" />
            }
            Import @selectedContexts.Count Cluster(s)
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private List<ClusterDto> clusters = new();
    private bool loading = true;
    private string? error;
    private Modal createModal = default!;
    private CreateClusterDto newCluster = new();
    private bool creating;
    private string? createError;
    
    // Import from kubeconfig
    private Modal importModal = default!;
    private string kubeconfigPath = Environment.ExpandEnvironmentVariables("%USERPROFILE%\\.kube\\config");
    private List<KubeContextInfo> availableContexts = new();
    private HashSet<string> selectedContexts = new();
    private bool loadingContexts;
    private bool importing;
    private string? importError;
    private string importEnvironment = "Development";

    protected override async Task OnInitializedAsync()
    {
        await LoadClusters();
        
        // Nếu không có cluster nào, tự động import từ kubeconfig mặc định
        if (!clusters.Any())
        {
            await AutoImportDefaultCluster();
        }
    }

    private async Task LoadClusters()
    {
        loading = true;
        error = null;
        
        try
        {
            clusters = await ApiClient.GetClustersAsync();
        }
        catch (Exception ex)
        {
            error = $"Failed to load clusters: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task AutoImportDefaultCluster()
    {
        try
        {
            var defaultKubeconfigPath = Environment.ExpandEnvironmentVariables("%USERPROFILE%\\.kube\\config");
            
            if (!File.Exists(defaultKubeconfigPath))
            {
                Console.WriteLine("Default kubeconfig not found");
                return;
            }

            var yamlContent = await File.ReadAllTextAsync(defaultKubeconfigPath);
            var deserializer = new YamlDotNet.Serialization.DeserializerBuilder().Build();
            var dict = new Dictionary<object, object>();
            try 
            {
                dict = deserializer.Deserialize<Dictionary<object, object>>(yamlContent);
            }
            catch { return; }

            // Lấy current-context
            string? currentContext = null;
            if (dict.ContainsKey("current-context"))
            {
                currentContext = dict["current-context"]?.ToString();
            }

            // Nếu không có current-context, lấy context đầu tiên
            if (string.IsNullOrEmpty(currentContext) && dict.ContainsKey("contexts"))
            {
                var ctxList = dict["contexts"] as List<object>;
                if (ctxList != null && ctxList.Any())
                {
                    var firstCtx = ctxList.First() as Dictionary<object, object>;
                    if (firstCtx != null && firstCtx.ContainsKey("name"))
                    {
                        currentContext = firstCtx["name"]?.ToString();
                    }
                }
            }

            if (!string.IsNullOrEmpty(currentContext))
            {
                // Tự động import cluster mặc định
                var request = new CreateClusterRequest(
                    Name: currentContext,
                    KubeconfigPath: defaultKubeconfigPath,
                    ContextName: currentContext,
                    IsDefault: true,
                    Environment: "Development",
                    Description: "Auto-imported from default kubeconfig"
                );

                await ApiClient.CreateClusterAsync(request);
                await LoadClusters();
                
                Console.WriteLine($"Auto-imported cluster: {currentContext}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to auto-import cluster: {ex.Message}");
        }
    }

    private async Task ShowCreateModal()
    {
        newCluster = new CreateClusterDto();
        createError = null;
        await createModal.ShowAsync();
    }

    private async Task HideCreateModal()
    {
        await createModal.HideAsync();
    }

    private async Task CreateCluster()
    {
        if (string.IsNullOrWhiteSpace(newCluster.Name) ||
            string.IsNullOrWhiteSpace(newCluster.KubeconfigPath) ||
            string.IsNullOrWhiteSpace(newCluster.ContextName))
        {
            createError = "Please fill in all required fields";
            return;
        }

        creating = true;
        createError = null;

        try
        {
            var request = new CreateClusterRequest(
                newCluster.Name,
                newCluster.KubeconfigPath,
                newCluster.ContextName,
                newCluster.IsDefault,
                newCluster.Environment,
                newCluster.Description
            );
            var result = await ApiClient.CreateClusterAsync(request);
            await HideCreateModal();
            await LoadClusters();
        }
        catch (Exception ex)
        {
            createError = $"Failed to create cluster: {ex.Message}";
        }
        finally
        {
            creating = false;
        }
    }

    private async Task DeleteCluster(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this cluster?"))
            return;

        try
        {
            await ApiClient.DeleteClusterAsync(id);
            await LoadClusters();
        }
        catch (Exception ex)
        {
            error = $"Failed to delete cluster: {ex.Message}";
        }
    }

    private async Task SetDefault(int id)
    {
        try
        {
            await ApiClient.SetDefaultClusterAsync(id);
            await LoadClusters();
        }
        catch (Exception ex)
        {
            error = $"Failed to set default cluster: {ex.Message}";
        }
    }

    // Import from kubeconfig methods
    private async Task ShowImportModal()
    {
        availableContexts.Clear();
        selectedContexts.Clear();
        importError = null;
        await importModal.ShowAsync();
    }

    private async Task HideImportModal()
    {
        await importModal.HideAsync();
    }

    private async Task LoadContextsFromKubeconfig()
    {
        loadingContexts = true;
        importError = null;
        availableContexts.Clear();
        selectedContexts.Clear();

        try
        {
            var expandedPath = Environment.ExpandEnvironmentVariables(kubeconfigPath);
            
            if (!File.Exists(expandedPath))
            {
                importError = $"Kubeconfig file not found: {expandedPath}";
                return;
            }

            var yamlContent = await File.ReadAllTextAsync(expandedPath);
            var deserializer = new YamlDotNet.Serialization.DeserializerBuilder().Build();
            var dict = new Dictionary<object, object>();
            try
            {
                dict = deserializer.Deserialize<Dictionary<object, object>>(yamlContent);
            }
            catch (Exception ex)
            {
                importError = $"Invalid YAML format: {ex.Message}";
                return;
            }

            if (dict.ContainsKey("contexts") && dict["contexts"] is List<object> contextsList)
            {
                foreach (var item in contextsList)
                {
                    var ctx = item as Dictionary<object, object>;
                    if (ctx != null && ctx.ContainsKey("name") && ctx.ContainsKey("context"))
                    {
                        var name = ctx["name"]?.ToString() ?? "";
                        var contextData = ctx["context"] as Dictionary<object, object>;
                        var cluster = contextData?.ContainsKey("cluster") == true ? contextData["cluster"]?.ToString() : "";
                        var user = contextData?.ContainsKey("user") == true ? contextData["user"]?.ToString() : "";

                        availableContexts.Add(new KubeContextInfo
                        {
                            Name = name,
                            Cluster = cluster ?? "",
                            User = user ?? ""
                        });
                    }
                }
            }

            if (!availableContexts.Any())
            {
                importError = "No contexts found in kubeconfig file";
            }
        }
        catch (Exception ex)
        {
            importError = $"Failed to read kubeconfig: {ex.Message}";
        }
        finally
        {
            loadingContexts = false;
        }
    }

    private void ToggleAllContexts(bool selected)
    {
        selectedContexts.Clear();
        if (selected)
        {
            foreach (var ctx in availableContexts)
            {
                selectedContexts.Add(ctx.Name);
            }
        }
    }

    private void ToggleContext(string contextName, bool selected)
    {
        if (selected)
        {
            selectedContexts.Add(contextName);
        }
        else
        {
            selectedContexts.Remove(contextName);
        }
    }

    private async Task ImportSelectedClusters()
    {
        importing = true;
        importError = null;

        try
        {
            var expandedPath = Environment.ExpandEnvironmentVariables(kubeconfigPath);
            int successCount = 0;
            
            foreach (var contextName in selectedContexts)
            {
                try
                {
                    var request = new CreateClusterRequest(
                        Name: contextName,
                        KubeconfigPath: expandedPath,
                        ContextName: contextName,
                        IsDefault: false,
                        Environment: importEnvironment,
                        Description: $"Imported from {Path.GetFileName(expandedPath)}"
                    );
                    
                    await ApiClient.CreateClusterAsync(request);
                    successCount++;
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Failed to import {contextName}: {ex.Message}");
                }
            }

            await HideImportModal();
            await LoadClusters();
            
            if (successCount > 0)
            {
                error = null;
            }
        }
        catch (Exception ex)
        {
            importError = $"Failed to import clusters: {ex.Message}";
        }
        finally
        {
            importing = false;
        }
    }

    private BadgeColor GetEnvironmentColor(string? environment)
    {
        return environment?.ToLower() switch
        {
            "production" => BadgeColor.Danger,
            "staging" => BadgeColor.Warning,
            "development" => BadgeColor.Info,
            _ => BadgeColor.Secondary
        };
    }

    private class CreateClusterDto
    {
        public string Name { get; set; } = "";
        public string KubeconfigPath { get; set; } = "";
        public string ContextName { get; set; } = "";
        public bool IsDefault { get; set; }
        public string? Environment { get; set; }
        public string? Description { get; set; }
    }

    private class KubeContextInfo
    {
        public string Name { get; set; } = "";
        public string Cluster { get; set; } = "";
        public string User { get; set; } = "";
    }
}
